  m_Name:
  m_EditorClassIdentifier:
  itemId: 300
  indentLevel: 0
  storyText: 你动静小一点，别惊动了其他人。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 114383073416827307}
