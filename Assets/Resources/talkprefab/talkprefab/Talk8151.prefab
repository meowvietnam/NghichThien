  m_Name:
  m_EditorClassIdentifier:
  itemId: 292
  indentLevel: 0
  storyText: 与上次不同，这次你几乎是戏耍着对方结束了战斗。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 0}
