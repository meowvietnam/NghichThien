  m_Name:
  m_EditorClassIdentifier:
  itemId: 795
  indentLevel: 0
  storyText: 嗯，正如你当时推断，她只是神魂受损，闭关修养一段时间便无大碍了。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 114240917112521434}
