  m_Name:
  m_EditorClassIdentifier:
  itemId: 253
  indentLevel: 0
  storyText: 总之...炼制这丹药需两味主药，一味聚元，一味生息，而辅药则需用到三份木灵三针花，再配以药引平衡寒热，便可成丹。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 114214603739988979}
  AvatarIntID: 1
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
