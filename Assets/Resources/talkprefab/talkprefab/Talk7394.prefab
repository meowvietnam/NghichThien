  m_Name:
  m_EditorClassIdentifier:
  itemId: 583
  indentLevel: 0
  storyText: 没成想这冲虚一见是我，就驱动神通攻将上来，打我一个措手不及。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 1
