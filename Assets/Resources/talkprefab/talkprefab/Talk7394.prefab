  m_Name:
  m_EditorClassIdentifier:
  itemId: 1398
  indentLevel: 0
  storyText: 你这徒儿平日里的为人的确没有问题，但吾辈修士谁不是向着长生而去，又有谁甘心苦修数百年后落得个寿终而亡的结局？
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 114894674902804486}
  AvatarIntID: 2243
