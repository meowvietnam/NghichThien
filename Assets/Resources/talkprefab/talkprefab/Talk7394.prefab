  m_Name:
  m_EditorClassIdentifier:
  itemId: 585
  indentLevel: 0
  storyText: 当年你徒儿要当众格杀我这晚辈时，没见你加以阻拦。今日我击败他，你却又在此饶舌。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 1
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
