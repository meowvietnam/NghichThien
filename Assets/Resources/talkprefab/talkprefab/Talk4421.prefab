--- !u!114 &114309589537292539
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1857363845242078}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cbdfddbb1a7e9dedeeccda6985376314, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  itemId: 313
  indentLevel: 0
  storyText: 天机阁的小型交易会，主要是为了方便诸位换取一些平日里有价无市的稀有宝物，因此对于寄换物品的价值也有一定的基础要求。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 114273159719779434}
  AvatarIntID: 0
  character: {fileID: 0}
  portrait: {fileID: 0}
