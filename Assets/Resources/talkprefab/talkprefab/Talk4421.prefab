--- !u!114 &114371322690467951
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1857363845242078}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cbdfddbb1a7e9dedeeccda6985376314, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  itemId: 262
  indentLevel: 0
  storyText: 他一挥手，几块巨大的骨骸便浮现于高台之上。从这些骨骸上隐隐出来的威压与极为厚重的土属性灵气，就知道它们并非凡品。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 114273159719779434}
  AvatarIntID: 0
