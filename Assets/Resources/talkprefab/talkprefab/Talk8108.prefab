  m_Name:
  m_EditorClassIdentifier:
  itemId: 1526
  indentLevel: 0
  storyText: 我虽心有不甘，但当务之急还是重新炼制一个合适的法宝傍身更要紧。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 114540625957841908}
