  m_Name:
  m_EditorClassIdentifier:
  itemId: 367
  indentLevel: 0
  storyText: 本座乃通古门长老鸿凌子，若有人能看到这里，证明本座修真之路已断，最终也未能突破到化神期。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 0}
  AvatarIntID: 1
