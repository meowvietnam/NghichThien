  m_Name:
  m_EditorClassIdentifier:
  itemId: 273
  indentLevel: 0
  storyText: '{FirstName}{shidi}，你最近是见不到家师了。自我接手绝焰堂之后，唉，师尊倒是也放心把这里里外外的事情都交给我。'
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 114880411685886736}
  AvatarIntID: 0
  character: {fileID: 0}
  portrait: {fileID: 0}
