  m_Script: {fileID: 11500000, guid: cbdfddbb1a7e9dedeeccda6985376314, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  itemId: 245
  indentLevel: 1
  storyText: 眼前之人在你的感知之下，似是一座即将喷发的火山，内里炙热翻涌表面气息却是静若止水。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 114880411685886736}
  AvatarIntID: 0
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
