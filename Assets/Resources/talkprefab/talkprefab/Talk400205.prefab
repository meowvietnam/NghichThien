  m_EditorClassIdentifier:
  itemId: 1389
  indentLevel: 0
  storyText: 吾辈既已触及天道，本只愿静心潜修不想插手世事。但{$shili}有难，也只得出面了。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 114223516971200246}
