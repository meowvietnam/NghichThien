  m_Name:
  m_EditorClassIdentifier:
  itemId: 157
  indentLevel: 0
  storyText: 循声而望，隐约可见一片岛屿，想必他便是在其中某座岛上，只是不知与之对饮的修士是哪位。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 0}
  AvatarIntID: 0
