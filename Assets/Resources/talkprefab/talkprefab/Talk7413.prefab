  m_Name:
  m_EditorClassIdentifier:
  itemId: 156
  indentLevel: 0
  storyText: 但白帝也就邀请了宁州的几位化神修士，白鹿为人孤僻，星凝又不像是能跟混元子聊得来的样子，应当是明山散人或火麒麟没错了。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 0}
  AvatarIntID: 0
