  m_Name:
  m_EditorClassIdentifier:
  itemId: 1169
  indentLevel: 0
  storyText: 他惯穿的那身纤尘不染的白色道袍如今下摆已是破败不堪，右肩部分更是少了一大块，露出里面被魔气沾染的伤口。脸上虽看似保持着平静，但眉头间凝结着不甘，眼神中更是蕴含着杀意。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 114166675887973513}
  AvatarIntID: 0
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 1
  waitForClick: 1
  stopVoiceover: 1
  waitForVO: 0
  setSayDialog: {fileID: 0}
--- !u!114 &114677149859593497
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1456526907896883}
  m_Enabled: 1
  m_EditorHideFlags: 0
