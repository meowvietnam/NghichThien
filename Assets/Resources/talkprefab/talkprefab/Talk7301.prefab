  m_Name:
  m_EditorClassIdentifier:
  itemId: 286
  indentLevel: 0
  storyText: 没想到位面之间的灵气乱流果真如此恐怖，即便以我如今的修为也难以抵挡。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 1
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
