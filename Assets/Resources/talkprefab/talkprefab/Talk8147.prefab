  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cbdfddbb1a7e9dedeeccda6985376314, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  itemId: 770
  indentLevel: 1
  storyText: 一声话语冷不丁地插入到你二人的对话中，听声音正是“已故”的枯木老祖。
  description:
  AvatarIDSetType: 1
