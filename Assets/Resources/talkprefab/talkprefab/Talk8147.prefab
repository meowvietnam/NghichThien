  m_Name:
  m_EditorClassIdentifier:
  itemId: 796
  indentLevel: 0
  storyText: 师兄，你大可不必...当年化树之后，我便已是想明白。明明走上修仙一途是为了除魔，最后却勾结魔教。这是我的错，我自己担就好。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 114056148173865502}
  AvatarIntID: 1
  character: {fileID: 0}
  portrait: {fileID: 0}
