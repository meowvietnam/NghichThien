  m_Name:
  m_EditorClassIdentifier:
  itemId: 782
  indentLevel: 0
  storyText: 此事说来话长。简单点来说，就是后来我发现枯木师弟的魂魄在那人形树中没有消散，而且念及他已经为自己的行为付出了代价，所以我将魂魄收入沁云竹中，以期有机会让他赎罪，例如主导这幻雾阵以供门内弟子长老等增加战斗经验，熟练神通使用。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 114380967026490164}
  AvatarIntID: 0
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 1
  waitForClick: 1
  stopVoiceover: 1
  waitForVO: 0
  setSayDialog: {fileID: 0}
