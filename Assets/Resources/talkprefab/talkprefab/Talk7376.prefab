  m_Name:
  m_EditorClassIdentifier:
  itemId: 1099
  indentLevel: 0
  storyText: 咳，咳咳，道友，不，前，前辈，我这就把秘术交予你，请，咳咳咳，饶我一命。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 677
