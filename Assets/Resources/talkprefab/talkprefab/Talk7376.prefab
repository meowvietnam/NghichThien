  m_Name:
  m_EditorClassIdentifier:
  itemId: 1102
  indentLevel: 0
  storyText: 只要别拖太久，被发现就好。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 0
