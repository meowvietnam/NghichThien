  m_Name:
  m_EditorClassIdentifier:
  itemId: 445
  indentLevel: 0
  storyText: 你没有插话，她也终于因为有些哽咽而语速慢了下来，甚至花了点时间整理心情后才继续说下去。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 0}
  AvatarIntID: 1
