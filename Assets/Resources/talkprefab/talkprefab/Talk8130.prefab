  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cbdfddbb1a7e9dedeeccda6985376314, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  itemId: 403
  indentLevel: 0
  storyText: 此物可提升修为，可增加实力，可延长寿命，若非本就天赋异禀，又有谁会在逆天修行的棘途上不渴求这些圆滚滚的，小“玩意”呢？
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 0}
  AvatarIntID: 0
