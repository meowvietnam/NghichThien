  m_Name:
  m_EditorClassIdentifier:
  itemId: 402
  indentLevel: 0
  storyText: 这秘市之中的交易抽水很大，所以物价也比一般坊市要贵上不少。若是阁下在秘市中买了什么东西，我自然也能得到一笔不错的报酬。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 746
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
