  m_Name:
  m_EditorClassIdentifier:
  itemId: 326
  indentLevel: 0
  storyText: 轻而易举地，你找到了傀儡师新建的入口。看那甬道上的抓痕，似乎是用尸傀挖开的。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 114704439000144027}
  AvatarIntID: 0
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 1
  waitForClick: 1
  stopVoiceover: 1
  waitForVO: 0
  setSayDialog: {fileID: 0}
--- !u!114 &114359788798475441
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1476783233174730}
