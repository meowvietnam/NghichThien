--- !u!114 &114183208173464182
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1476783233174730}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cbdfddbb1a7e9dedeeccda6985376314, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  itemId: 294
  indentLevel: 0
  storyText: 几轮鏖斗之后，你竟有些灵气不济，慌乱之下他并没有给你运气调息的机会。只见一道金色的剑芒斩在你的灵气护罩上，竟将你震得两眼一黑。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 0}
  AvatarIntID: 0
