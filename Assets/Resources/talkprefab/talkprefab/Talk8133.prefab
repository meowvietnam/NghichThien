  m_Name:
  m_EditorClassIdentifier:
  itemId: 324
  indentLevel: 0
  storyText: 你随手将阵法解除，被掩盖的环境出现在你身前。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 114704439000144027}
