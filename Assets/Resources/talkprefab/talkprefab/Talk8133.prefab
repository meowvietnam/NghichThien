  m_Name:
  m_EditorClassIdentifier:
  itemId: 299
  indentLevel: 0
  storyText: 这尸傀对你来说虽有些新奇，但显然现在不是取乐的时候。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 114704439000144027}
