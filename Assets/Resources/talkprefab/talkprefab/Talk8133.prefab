  m_Name:
  m_EditorClassIdentifier:
  itemId: 312
  indentLevel: 0
  storyText: 这东西的战斗力实在超乎想象，我还是先逃为妙。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 114704439000144027}
