--- !u!114 &114969067848591408
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1373950504577010}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cbdfddbb1a7e9dedeeccda6985376314, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  itemId: 297
  indentLevel: 0
  storyText: 吴四海，你若是手痒，我来做你的对手。不过今日是小辈间的比试，咱们这些长老堂的老骨头们就别凑这个热闹了。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 114272755921383909}
  AvatarIntID: 0
  character: {fileID: 0}
  portrait: {fileID: 0}
