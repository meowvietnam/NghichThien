  m_Name:
  m_EditorClassIdentifier:
  itemId: 334
  indentLevel: 0
  storyText: 好，比试也差不多该开始了，下面就按规矩，请代表唐家和长老堂出战的两位道友上场吧。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 114659475304843547}
