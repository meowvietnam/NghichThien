  m_Name:
  m_EditorClassIdentifier:
  itemId: 334
  indentLevel: 0
  storyText: 并无，说来也怪，吸收魔气的剑极其罕见，但我却一点也想不起与此剑相关之事。
  description:
  AvatarIDSetType: 1
