  m_Name:
  m_EditorClassIdentifier:
  itemId: 1103
  indentLevel: 2
  storyText: 轩儿能够走到这一步，我确实为他感到骄傲。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 114965758067797328}
  AvatarIntID: 0
