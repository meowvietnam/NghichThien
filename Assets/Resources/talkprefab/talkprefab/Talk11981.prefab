  m_Name:
  m_EditorClassIdentifier:
  itemId: 298
  indentLevel: 0
  storyText: 据说御剑门掌门也是个惊艳绝伦的人物，可惜与魔门勾结落了个死无全尸的下场。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 621
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
