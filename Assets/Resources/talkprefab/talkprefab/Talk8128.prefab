  m_Name:
  m_EditorClassIdentifier:
  itemId: 427
  indentLevel: 0
  storyText: 失踪的这位是新晋的金丹长老，她大约在三年前突破金丹期，随后不久便在密阁中兑换了新的功法玉简。若是不出意外，她这几年应该都在洞府中领悟新的功法。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 114659217591661080}
  AvatarIntID: 1
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 1
  waitForClick: 1
  stopVoiceover: 1
  waitForVO: 0
  setSayDialog: {fileID: 0}
