  m_Name:
  m_EditorClassIdentifier:
  itemId: 1324
  indentLevel: 0
  storyText: 魔教妖人手段诡异，若不是有{FirstName}{$NickName}陪同，{$ZaiXia}更不是那魔修对手了。
