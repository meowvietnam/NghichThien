  m_Name:
  m_EditorClassIdentifier:
  itemId: 1648
  indentLevel: 1
  storyText: 前些年我花重金托人为我寻觅炼心芝。没想到他居然告诉我在星河剑派西方接近衡州处有炼心芝的消息，若不是此人与我合作多次，颇有信誉，我是不会相信这个消息的。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 114709831619931774}
  AvatarIntID: 1
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 1
  waitForClick: 1
  stopVoiceover: 1
  waitForVO: 0
  setSayDialog: {fileID: 0}
