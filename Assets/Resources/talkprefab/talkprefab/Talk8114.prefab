--- !u!114 &114255356437965263
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1105831837161796}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cbdfddbb1a7e9dedeeccda6985376314, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  itemId: 1715
  indentLevel: 0
  storyText: 你刚迈入云汐城的客栈，{$NpcName}便迎了上来。打招呼的语气除高兴外似乎还掺杂些抱怨，不过反应倒是很快，后半句话还没说出口便是戛然而止。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 114541255998559816}
  AvatarIntID: 0
