  m_Name:
  m_EditorClassIdentifier:
  itemId: 1725
  indentLevel: 0
  storyText: 很简单，帮我揍他一顿，然后赶他离开就好。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 114541255998559816}
