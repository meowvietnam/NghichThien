  m_Name:
  m_EditorClassIdentifier:
  itemId: 303
  indentLevel: 1
  storyText: 在下{FirstName}{LastName}，为{color=#d0380a}逆天造化术{/color}而来，道友可愿指点一二？
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 1
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
