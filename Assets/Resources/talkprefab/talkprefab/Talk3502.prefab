  m_Name:
  m_EditorClassIdentifier:
  itemId: 430
  indentLevel: 1
  storyText: 阴气旋不远处，一群灵魂体围着一个较为凝实的灵魂体，似乎在商议着什么事情。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 114849605730766461}
  AvatarIntID: 0
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
