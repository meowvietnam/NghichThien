  m_Name:
  m_EditorClassIdentifier:
  itemId: 304
  indentLevel: 1
  storyText: 只见一众灵魂体神色复杂地望着你。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 114849605730766461}
  AvatarIntID: 0
