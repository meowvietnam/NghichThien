  m_Name:
  m_EditorClassIdentifier:
  itemId: 482
  indentLevel: 0
  storyText: 你的修仙路早就终止了不是么？就你现在的状态，别说离开这里，连修炼都做不到吧？
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 114995926396348792}
  AvatarIntID: 1
