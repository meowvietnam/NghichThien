  m_Name:
  m_EditorClassIdentifier:
  itemId: 1152
  indentLevel: 1
  storyText: 数个隐藏在附近的魔修向你二人袭击而来，霎时间这玄道宗的山门处已经是魔气纵横。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 114149277011726221}
  AvatarIntID: 0
