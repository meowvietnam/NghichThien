  m_Name:
  m_EditorClassIdentifier:
  itemId: 345
  indentLevel: 0
  storyText: 青石灵脉位于宁州西部山脉，与衡州接壤。灵脉由各大宗门轮流管理，对所有普通修士开放。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 114348954825966108}
  AvatarIntID: 0
  character: {fileID: 0}
  portrait: {fileID: 0}
