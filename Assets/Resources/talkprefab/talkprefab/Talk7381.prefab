  m_Name:
  m_EditorClassIdentifier:
  itemId: 448
  indentLevel: 1
  storyText: 冲虚散人话音未落，一道不起眼的细长金芒静谧无声地刺向你的眉心！
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 0
