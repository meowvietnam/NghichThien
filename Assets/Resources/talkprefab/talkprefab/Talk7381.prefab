  m_GameObject: {fileID: 1949454407945688}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cbdfddbb1a7e9dedeeccda6985376314, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  itemId: 513
  indentLevel: 0
  storyText: 你收下星宫秘术之后便是寒暄一会。不多时，星宫宫主就带星铃儿离去了。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 0
