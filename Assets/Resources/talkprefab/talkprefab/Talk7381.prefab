  m_Name:
  m_EditorClassIdentifier:
  itemId: 371
  indentLevel: 1
  storyText: 不好不好，还是太生分了些，不如叫我铃儿吧。铃儿，铃儿，多好听。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
