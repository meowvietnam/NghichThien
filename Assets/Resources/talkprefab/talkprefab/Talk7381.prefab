  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cbdfddbb1a7e9dedeeccda6985376314, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  itemId: 504
  indentLevel: 0
  storyText: 除非父亲能及时归来，不然只怕林家在天星城的地位要一落千丈。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
