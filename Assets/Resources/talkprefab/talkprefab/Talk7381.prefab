  m_EditorClassIdentifier:
  itemId: 511
  indentLevel: 0
  storyText: 此术名唤《神交法》，乃星宫高阶双修秘术，现以此法赠与小友，还请勿外传。
  description:
  AvatarIDSetType: 1
