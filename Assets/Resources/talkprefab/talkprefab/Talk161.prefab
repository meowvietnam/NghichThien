  m_EditorClassIdentifier:
  itemId: 292
  indentLevel: 0
  storyText: 聚灵阵是一种用灵石布下的基础阵法，可以慢慢地将周天的灵气汇聚集中起来，放在老夫当年，可都是修真门派才有这样的手笔。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 2
