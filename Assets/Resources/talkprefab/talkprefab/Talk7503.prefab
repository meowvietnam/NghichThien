  m_Name:
  m_EditorClassIdentifier:
  itemId: 401
  indentLevel: 0
  storyText: 公孙兄特地约我来此，又问了这么些奇怪的问题，应该不只是为了找我品酒赏景吧？
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
