  m_Name:
  m_EditorClassIdentifier:
  itemId: 524
  indentLevel: 0
  storyText: 多谢师兄，但这凡俗之礼就不必了。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 1
  character: {fileID: 0}
