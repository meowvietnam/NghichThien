  m_Name:
  m_EditorClassIdentifier:
  itemId: 1100
  indentLevel: 0
  storyText: （虽说可能只是巧合...但若是我的推测没错，魔门随时会入侵宁州，现在可不能再浪费时间了！得赶紧用传音符通知倪兄或是白帝楼才行！）
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 1
