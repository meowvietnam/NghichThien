  m_Name:
  m_EditorClassIdentifier:
  itemId: 1068
  indentLevel: 0
  storyText: （炎萧去过天魔眼一事本应只有玄道宗的相关人士知道，若他是为门派奔波，也只是再加上离火门的掌门等人知晓。）
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 114057794174024582}
  AvatarIntID: 1
  character: {fileID: 0}
  portrait: {fileID: 0}
