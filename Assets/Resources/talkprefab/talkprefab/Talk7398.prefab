  m_Name:
  m_EditorClassIdentifier:
  itemId: 870
  indentLevel: 0
  storyText: 当你的神识触及到那片黑暗中心时，却什么都没有发现，或者说除浓重到让人不适的魔气外，什么都没有，连阵法都已是支离破碎。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 0}
  AvatarIntID: 0
