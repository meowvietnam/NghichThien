  m_Name:
  m_EditorClassIdentifier:
  itemId: 1129
  indentLevel: 0
  storyText: 以致于他说完顿了片刻，在你有些担心他状态时才挥挥手示意自己还好，而后继续说下去。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 0}
  AvatarIntID: 0
