  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cbdfddbb1a7e9dedeeccda6985376314, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  itemId: 962
  indentLevel: 1
  storyText: 这元婴期魔修虽是境界压你一头，但实战能力远不如你，更不用说她与炎萧鏖战已久，早就后继乏力。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 0}
  AvatarIntID: 0
