  m_GameObject: {fileID: 1355750475514256}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cbdfddbb1a7e9dedeeccda6985376314, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  itemId: 979
  indentLevel: 0
  storyText: 炎萧{$ChenHu}，那些天魔道的修士为何会在此围杀...炎萧{$ChenHu}？
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 114057794174024582}
