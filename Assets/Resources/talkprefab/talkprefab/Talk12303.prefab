--- !u!114 &114740097397039698
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1037211097004795}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cbdfddbb1a7e9dedeeccda6985376314, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  itemId: 569
  indentLevel: 0
  storyText: "我派目前还有授业的有三位长老，分别是火云，苍坤\r和正阳三位前辈，你想了解哪一位？"
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 114767898012641857}
  AvatarIntID: 410
  character: {fileID: 0}
  portrait: {fileID: 0}
