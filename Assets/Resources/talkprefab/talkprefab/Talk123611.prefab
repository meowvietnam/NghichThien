  m_EditorClassIdentifier:
  itemId: 457
  indentLevel: 0
  storyText: 道友，也是来购买丹药的么？我玄古门的丹药在衡州可是鼎鼎有名的。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 114888308277285199}
