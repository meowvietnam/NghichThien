--- !u!114 &114450330819206220
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1713000431784046}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cbdfddbb1a7e9dedeeccda6985376314, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  itemId: 611
  indentLevel: 0
  storyText: 好了，无惑师徒确实做的不对，小友你也不用再奚落他二人了。还是让冲虚自己来说说突破的事吧。有此事？
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 114631418436012594}
  AvatarIntID: 2239
