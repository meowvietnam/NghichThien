  m_Name:
  m_EditorClassIdentifier:
  itemId: 470
  indentLevel: 0
  storyText: 小友既身怀林家秘宝，想必是深受林家信任，便与本宫一同去林家吧。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 114631418436012594}
  AvatarIntID: 2243
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
