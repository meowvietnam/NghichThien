  m_Name:
  m_EditorClassIdentifier:
  itemId: 664
  indentLevel: 0
  storyText: 冲虚的情况的确不合常理，符合小友的怀疑。此事本宫会亲自调查，待事了之后给林家一个说法。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 114631418436012594}
