  m_Name:
  m_EditorClassIdentifier:
  itemId: 627
  indentLevel: 0
  storyText: 当年害星宫丢尽颜面的是谁，你心里没数么？居然还厚颜无耻的怪罪到我头上？
  description:
  AvatarIDSetType: 0
