  m_Name:
  m_EditorClassIdentifier:
  itemId: 296
  indentLevel: 0
  storyText: 见势不妙，“云清正”掐诀念咒，释放了古神教秘术，你们神识一滞，回过神来，云清正和古神教修士都已经不见了。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 0
