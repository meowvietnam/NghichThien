  m_Name:
  m_EditorClassIdentifier:
  itemId: 618
  indentLevel: 0
  storyText: 多谢{FirstName}{$zhanglao}陪我聊天解闷，但我有些累了，还是到此为止吧。
  description:
  AvatarIDSetType: 1
