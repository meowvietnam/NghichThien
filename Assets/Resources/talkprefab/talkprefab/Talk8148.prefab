  m_EditorClassIdentifier:
  itemId: 553
  indentLevel: 1
--- !u!114 &114748305536484113
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1893721009496742}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cbdfddbb1a7e9dedeeccda6985376314, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  itemId: 606
  indentLevel: 0
  storyText: 不过斯人已逝，那些破事也没必要再提了。要说繁花师弟，值得一提的还是他晋入元婴境后承下掌门一职，基于他自身实力让宗门周边安全了不少，门中弟子的活动范围也大上许多。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 114859886481251771}
  AvatarIntID: 0
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 1
  waitForClick: 1
  stopVoiceover: 1
  waitForVO: 0
  setSayDialog: {fileID: 0}
