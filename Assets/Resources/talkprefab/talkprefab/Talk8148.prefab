--- !u!114 &114285711450592272
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1893721009496742}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cbdfddbb1a7e9dedeeccda6985376314, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  itemId: 614
  indentLevel: 0
  storyText: 不过，比起处理宗门事务，师兄坐镇宗门的威慑更为重要，他多些时间修炼对竹山宗上下都有裨益，在我看来是个不错的选择。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 114859886481251771}
  AvatarIntID: 0
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 1
  waitForClick: 1
  stopVoiceover: 1
  waitForVO: 0
  setSayDialog: {fileID: 0}
--- !u!114 &114169651115165655
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1893721009496742}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cbdfddbb1a7e9dedeeccda6985376314, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  itemId: 593
  indentLevel: 0
  storyText: 明山师兄入门要早上许多，我突破到筑基期时，他已经是第二次参加天魔眼的猎魔大会了。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 114859886481251771}
  AvatarIntID: 1
