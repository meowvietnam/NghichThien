  m_Name:
  m_EditorClassIdentifier:
  itemId: 283
  indentLevel: 0
  storyText: 你祭出飞剑，一剑刺穿了毕钟天的小腿，他见退路已断，情急之下一时凶相毕露。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 0}
