  m_Name:
  m_EditorClassIdentifier:
  itemId: 361
  indentLevel: 0
  storyText: 正是，想来你将阵法破除后这虚弱的元神才有能力与你沟通。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 2
