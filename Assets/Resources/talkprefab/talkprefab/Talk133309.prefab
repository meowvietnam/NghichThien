  m_Name:
  m_EditorClassIdentifier:
  itemId: 345
  indentLevel: 0
  storyText: 元神的声音听起来苍老又无力，似是年迈修士所持有。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 0}
