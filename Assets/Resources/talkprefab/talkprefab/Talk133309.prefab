  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cbdfddbb1a7e9dedeeccda6985376314, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  itemId: 358
  indentLevel: 0
  storyText: 其上布置的骨钉是为锁住元神，令其不得逃脱。阵法所绘咒纹...哼，饶你修为再强，元神置入此阵犹如烈火油烹，端是狠辣无边！
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 2
