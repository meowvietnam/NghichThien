  m_EditorClassIdentifier:
  itemId: 376
  indentLevel: 0
  storyText: 再加上秋兰资质如此难得，我教长老不愿暴殄天物，好好培养，能为我教做出更大的贡献。
  description:
  AvatarIDSetType: 0
