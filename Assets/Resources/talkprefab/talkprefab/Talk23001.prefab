  m_Name:
  m_EditorClassIdentifier:
  itemId: 380
  indentLevel: 0
  storyText: 没想到平素温婉和善的澹台前辈，发起怒来竟是如此模样...大家面面相觑，很快便纷纷表态。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 0
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
