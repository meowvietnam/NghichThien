  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cbdfddbb1a7e9dedeeccda6985376314, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  itemId: 346
  indentLevel: 0
  storyText: 上古时期，我龙族本是居于东海，筑有龙宫，天下鳞甲来朝。不过鲲族狼子野心、冒然来袭，此战撼天动地上古龙宫更是被击沉于海底。最终我龙族虽惨胜，却也不得不退居于化龙海。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 820
