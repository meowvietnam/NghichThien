  m_Name:
  m_EditorClassIdentifier:
  itemId: 636
  indentLevel: 2
  storyText: 在你自以为即将得手时，一股强大的神识从你的位置扫过。紧接着几个守卫向你所在的方位赶来。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 0}
  AvatarIntID: 0
