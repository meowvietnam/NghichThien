  m_EditorClassIdentifier:
  itemId: 202
  indentLevel: 0
  storyText: '{$daoyou}，我调查村民失踪一案一路追查至此。你若不介意的话，我们一同出手如何？'
  description:
  AvatarIDSetType: 0
