  m_Name:
  m_EditorClassIdentifier:
  itemId: 195
  indentLevel: 0
  storyText: 但见他硬接一爪后，左手抓住那名禾山道修士的手腕，右手凝聚一团火球正中那人胸口。那人正面受此重伤，眼看是活不成了。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 0}
  AvatarIntID: 0
  character: {fileID: 0}
  portrait: {fileID: 0}
