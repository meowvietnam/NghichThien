  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1150613641295884}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cbdfddbb1a7e9dedeeccda6985376314, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  itemId: 632
  indentLevel: 0
  storyText: 其实能够结成六、七品金丹的，已是数一数二的佼佼者，我派数位长老之中能够有此等机遇者亦不多见。
  description:
  AvatarIDSetType: 0
