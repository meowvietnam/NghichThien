  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cbdfddbb1a7e9dedeeccda6985376314, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  itemId: 1038
  indentLevel: 0
  storyText: 这么一来，你就是我的徒弟了，在你{color=#d0380a}结丹之前{/color}，可要好好照我说的练。
