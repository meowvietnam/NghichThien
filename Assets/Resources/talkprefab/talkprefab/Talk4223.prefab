  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cbdfddbb1a7e9dedeeccda6985376314, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  itemId: 306
  indentLevel: 2
  storyText: 我也曾学过一门神通，唤作幻雾术，想来倒是与大圣的吐纳术有几分相似之处。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 114822543721438710}
  AvatarIntID: 1
