  m_Name:
  m_EditorClassIdentifier:
  itemId: 362
  indentLevel: 1
  storyText: 当年，我以家族遗留的一本《五府锻元决》进入了修真者的行列，如今……
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 114822543721438710}
