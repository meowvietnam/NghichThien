  m_Name:
  m_EditorClassIdentifier:
  itemId: 365
  indentLevel: 0
  storyText: （摇了摇头）虽然你所描述的世界很有趣，可惜并不适合我。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 114822543721438710}
