  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1289019186414845}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cbdfddbb1a7e9dedeeccda6985376314, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  itemId: 316
  indentLevel: 0
  storyText: 我们吞云蟒一族，与你们人类突破的方式虽说大不相同，却也殊途同归。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 114822543721438710}
