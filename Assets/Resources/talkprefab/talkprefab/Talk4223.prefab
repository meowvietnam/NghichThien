--- !u!114 &114272536247009540
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1289019186414845}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cbdfddbb1a7e9dedeeccda6985376314, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  itemId: 326
  indentLevel: 0
  storyText: 我想，在天劫来临前，我们应该尽可能提升自己的境界。境界越高，能够成功飞升的机会也一定会更高。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 114822543721438710}
  AvatarIntID: 0
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
