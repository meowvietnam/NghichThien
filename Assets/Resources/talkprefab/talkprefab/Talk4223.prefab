  m_Name:
  m_EditorClassIdentifier:
  itemId: 364
  indentLevel: 0
  storyText: 大圣既然可以化为人形，可有兴趣到人类的世界游历一番？
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 114822543721438710}
  AvatarIntID: 1
  character: {fileID: 0}
  portrait: {fileID: 0}
