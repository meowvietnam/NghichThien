  m_Name:
  m_EditorClassIdentifier:
  itemId: 273
  indentLevel: 0
  storyText: 走近观瞧，眼前正是化尘秘境的巨大玉门，门口则是几个熟悉的背影。
  description:
  AvatarIDSetType: 0
