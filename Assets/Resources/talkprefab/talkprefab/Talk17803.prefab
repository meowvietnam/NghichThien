  m_Name:
  m_EditorClassIdentifier:
  itemId: 287
  indentLevel: 0
  storyText: 恒如不敢怠慢，将数十个玉简收入储物袋中，深施一礼。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 0
