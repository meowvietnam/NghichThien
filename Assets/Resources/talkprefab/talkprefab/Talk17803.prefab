  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cbdfddbb1a7e9dedeeccda6985376314, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  itemId: 282
  indentLevel: 0
  storyText: 告诉冶庚上人，有事的话，来秘境大殿找我便是，没有要事，莫要惊扰。
  description:
  AvatarIDSetType: 0
