  m_Name:
  m_EditorClassIdentifier:
  itemId: 178
  indentLevel: 0
  storyText: 你走向林沐心，却见她正在试图用凡人的法子生火，不由得问候中多了些调侃。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 0}
  AvatarIntID: 1
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
