  m_Name:
  m_EditorClassIdentifier:
  itemId: 160
  indentLevel: 1
  storyText: 这声音，似乎有些熟悉？难不成是天星城的林沐心姑娘？
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 1
