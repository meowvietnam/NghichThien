  m_Name:
  m_EditorClassIdentifier:
  itemId: 253
  indentLevel: 0
  storyText: 鲜嫩多汁，肥而不腻什么的也不用多说，仅是看林沐心大快朵颐的样子便已经能感受到这烤肉的魅力。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 0}
  AvatarIntID: 0
