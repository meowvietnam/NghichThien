  m_Name:
  m_EditorClassIdentifier:
  itemId: 195
  indentLevel: 0
  storyText: 你看着眼前这一串串的黑色碳状物，完全无法将之和食物联系在一起。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 0}
  AvatarIntID: 1
