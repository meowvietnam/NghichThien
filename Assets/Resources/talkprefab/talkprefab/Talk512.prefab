  m_Name:
  m_EditorClassIdentifier:
  itemId: 359
  indentLevel: 0
  storyText: 不错，这倪家还真算是客气周到，有了这些灵石，也能让你轻松一段日子了。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 2
