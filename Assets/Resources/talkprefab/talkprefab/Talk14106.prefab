  m_Name:
  m_EditorClassIdentifier:
  itemId: 927
  indentLevel: 0
  storyText: 此乃清月令，我派执掌的后山中有一清月谭，持有此令方可前往潭中。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 317
