--- !u!114 &114690432290677808
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1978568341138448}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cbdfddbb1a7e9dedeeccda6985376314, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  itemId: 501
  indentLevel: 0
  storyText: 是呀是呀~如果我们恢复了法力，你就能更容易地和你父母会合了，他明我暗，胜负还未可知。
  description:
  AvatarIDSetType: 0
