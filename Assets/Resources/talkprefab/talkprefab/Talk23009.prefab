  m_Name:
  m_EditorClassIdentifier:
  itemId: 267
  indentLevel: 0
  storyText: "别...别告诉我师父...\r\n"
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 530
  character: {fileID: 0}
