  m_Name:
  m_EditorClassIdentifier:
  itemId: 262
  indentLevel: 1
  storyText: 五行剑诀，当真是名副其实，{$TmpTalkString}能够领悟，可真是不简单啊！
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 317
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
