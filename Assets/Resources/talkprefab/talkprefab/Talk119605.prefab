  m_Name:
  m_EditorClassIdentifier:
  itemId: 288
  indentLevel: 2
  storyText: 我虽代表星河剑派受邀带队前来，可惜我本人并不擅长剑法，实在是惭愧非常。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 317
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
