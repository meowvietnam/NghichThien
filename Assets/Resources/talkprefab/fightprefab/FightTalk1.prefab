--- !u!114 &114520390451146114
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1389868644847223}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cbdfddbb1a7e9dedeeccda6985376314, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  itemId: 183
  indentLevel: 1
  storyText: 点击技能图标以释放{color=#d0380a}运气术{/color}。释放技能时，你可以手动调整待选区的灵气。选择三种你暂时无需使用的灵气，便有可能通过{color=#d0380a}运气术{/color}重新吸收到你所需要的灵气。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 0
