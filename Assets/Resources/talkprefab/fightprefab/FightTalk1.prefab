  m_EditorClassIdentifier:
  itemId: 128
  indentLevel: 1
  storyText: 看来掌握的还不错，不过仙家法门妙用无穷，你若是能领悟{color=#d0380a}五行相生{/color}的技巧，这些基础法术也会威力大增。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 2
