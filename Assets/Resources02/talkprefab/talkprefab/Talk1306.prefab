  m_EditorClassIdentifier:
  itemId: 475
  indentLevel: 0
  storyText: '{FirstName}{xiongdi}说笑了，我不过是跑了一趟腿而已，哈哈哈。'
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
