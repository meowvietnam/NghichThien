  m_EditorClassIdentifier:
  itemId: 440
  indentLevel: 0
  storyText: 他手上灵气若隐若现，显然已经开始酝酿攻击。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
