  m_Name:
  m_EditorClassIdentifier:
  itemId: 435
  indentLevel: 0
  storyText: 我们来这里只是想调查当年之事的原委，若是再添新仇恨，也实非我的本意。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 3006
