  m_Name:
  m_EditorClassIdentifier:
  itemId: 164
  indentLevel: 2
  storyText: 我代师兄多谢诸位愿前来观礼。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 1
