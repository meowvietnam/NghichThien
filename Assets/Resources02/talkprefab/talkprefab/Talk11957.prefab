  m_Name:
  m_EditorClassIdentifier:
  itemId: 413
  indentLevel: 1
  storyText: 虽说是对鉴定没有深入研究过，但即便只是粗浅的感受一番台座上所镌刻聚灵阵的复杂程度和强大效用，也不难猜出此等台座乃非凡之物。造价甚至可能要高于寻常宗门金丹长老的本命法宝。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 0}
  AvatarIntID: 0
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 1
  waitForClick: 1
  stopVoiceover: 1
  waitForVO: 0
