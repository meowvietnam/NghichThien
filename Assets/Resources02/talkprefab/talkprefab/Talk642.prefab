  m_Name:
  m_EditorClassIdentifier:
  itemId: 249
  indentLevel: 0
  storyText: 先是几道似有似无的雷鸣之声，由远及近。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 0}
  AvatarIntID: 0
