  m_Script: {fileID: 11500000, guid: cbdfddbb1a7e9dedeeccda6985376314, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  itemId: 1665
  indentLevel: 0
  storyText: 总之，能找到些稀有草药矿石就不错了。像那些不靠谱的传言，不听也罢！
  description:
  AvatarIDSetType: 1
