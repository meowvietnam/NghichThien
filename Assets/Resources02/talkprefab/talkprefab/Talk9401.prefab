  m_EditorClassIdentifier:
  itemId: 1453
  indentLevel: 0
  storyText: 重铸的任务开始之后，需要定期组织巡逻，清除妖兽魔物等，以防它们侵入驻地。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 114112171336744995}
  AvatarIntID: 0
  character: {fileID: 0}
  portrait: {fileID: 0}
