  m_Name:
  m_EditorClassIdentifier:
  itemId: 366
  indentLevel: 1
  storyText: 这里是阴冥海，无尽之海上最为神秘危险的海域之一，我对这里也知之甚少...
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 114122878541789130}
  AvatarIntID: 0
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
