  m_Name:
  m_EditorClassIdentifier:
  itemId: 779
  indentLevel: 2
  storyText: 炎萧{$ChenHao}小心，我来援助你了！
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 1
