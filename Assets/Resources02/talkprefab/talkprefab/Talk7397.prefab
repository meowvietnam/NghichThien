  m_Name:
  m_EditorClassIdentifier:
  itemId: 780
  indentLevel: 2
  storyText: 哼，区区元婴期魔修，安敢在此造次！
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 1
