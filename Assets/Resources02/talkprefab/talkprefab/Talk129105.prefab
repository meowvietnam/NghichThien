  m_Name:
  m_EditorClassIdentifier:
  itemId: 680
  indentLevel: 0
  storyText: '{$daoyouPlayer}收集材料不易，这东西我就赠与你吧。'
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 1
  character: {fileID: 0}
  portrait: {fileID: 0}
