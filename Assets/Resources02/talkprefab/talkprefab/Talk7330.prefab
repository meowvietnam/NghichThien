  m_EditorClassIdentifier:
  itemId: 363
  indentLevel: 1
  storyText: 不知{FirstName}{gongzi}手上可有涵虚仙府的玉佩。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 616
