  m_Name:
  m_EditorClassIdentifier:
  itemId: 366
  indentLevel: 1
  storyText: 在宝光的照耀下，仙府外围的阵法逐渐消融，涵虚仙府的正体也是出现在了你们眼前。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 0}
  AvatarIntID: 616
