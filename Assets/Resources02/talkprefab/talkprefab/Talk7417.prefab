  setSayDialog: {fileID: 0}
--- !u!114 &114641343871078608
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1786085892013967}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cbdfddbb1a7e9dedeeccda6985376314, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  itemId: 246
  indentLevel: 0
  storyText: 火麒麟迎上红莲，混元子对上血亢...正魔两道的化神转瞬间便战作一团，而刚刚一直站在血薇身后的血河老祖，此时也正一脸坏笑的看着你。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 0}
  AvatarIntID: 0
