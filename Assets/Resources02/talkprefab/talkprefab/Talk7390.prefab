  m_Name:
  m_EditorClassIdentifier:
  itemId: 1309
  indentLevel: 1
  storyText: 你赶到林沐心和神秘修士的战场时，这里站着的已只有林沐心。而那神秘修士却是不知去向，倒是宫主身旁有一抔黄土。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 0}
  AvatarIntID: 1
