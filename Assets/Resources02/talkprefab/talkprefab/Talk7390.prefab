  m_Name:
  m_EditorClassIdentifier:
  itemId: 1145
  indentLevel: 0
  storyText: 不过若不是那废物给我求情，我只怕是早死在了星凝那贱人的手下，也不会有加入古神教的机会，磔磔磔。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 114942471640292643}
  AvatarIntID: 1
  character: {fileID: 0}
  portrait: {fileID: 0}
