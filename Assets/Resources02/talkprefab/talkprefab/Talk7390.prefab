  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1014070186246080}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cbdfddbb1a7e9dedeeccda6985376314, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  itemId: 1197
  indentLevel: 0
  storyText: 你还在提出自己的疑问，却看到星宫宫主转过身来，你看到她怀里还有穿着同样衣服的另一位“宫主”。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 114671932707645432}
  AvatarIntID: 0
