  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cbdfddbb1a7e9dedeeccda6985376314, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  itemId: 1283
  indentLevel: 3
  storyText: 但在冲虚散人的话音落下后，在你耳旁响起的只有一如既往的怨恨悲啸，除此之外就只有不远处林沐心与魔修交手的声音在阵法空间内回响。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 0}
  AvatarIntID: 1
