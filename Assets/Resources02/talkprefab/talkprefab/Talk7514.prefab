  m_Name:
  m_EditorClassIdentifier:
  itemId: 265
  indentLevel: 1
  storyText: 你准备公开悬赏他？
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 1
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
