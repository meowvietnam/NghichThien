  m_Name:
  m_EditorClassIdentifier:
  itemId: 307
  indentLevel: 0
  storyText: 说到这里，公孙季仿佛终于松了一口气。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 114846744996713668}
  AvatarIntID: 0
  character: {fileID: 0}
  portrait: {fileID: 0}
