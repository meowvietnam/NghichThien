--- !u!114 &114064850343529361
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1396198557251398}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cbdfddbb1a7e9dedeeccda6985376314, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  itemId: 259
  indentLevel: 1
  storyText: 这些年来，公孙府内有不少长老被他收买。除此以外，他还有几条暗线专门接取一些特殊的悬赏用以敛财。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 114846744996713668}
  AvatarIntID: 0
  character: {fileID: 0}
  portrait: {fileID: 0}
