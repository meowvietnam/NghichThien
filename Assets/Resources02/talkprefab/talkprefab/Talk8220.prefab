  m_Name:
  m_EditorClassIdentifier:
  itemId: 308
  indentLevel: 0
  storyText: 我只知道万魂殿长老有一把万魂幡，每过一段时间便会过来收取一次魂魄。其他的便不得而知了。
  description:
  AvatarIDSetType: 0
