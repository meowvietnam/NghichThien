  m_EditorClassIdentifier:
  itemId: 158
  indentLevel: 1
  storyText: 这枯木林...为何会如此凋敝？若说上次来是一片枯林，现在这样子说是一片死地也不为过...
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 1
