  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cbdfddbb1a7e9dedeeccda6985376314, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  itemId: 284
  indentLevel: 1
  storyText: 能够集齐五行剑法、重续五行剑诀道统，{$TmpTalkString}可真是厉害非常，在下佩服！佩服！
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 117
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 1
