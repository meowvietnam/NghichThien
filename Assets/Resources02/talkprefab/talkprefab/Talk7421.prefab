  m_Name:
  m_EditorClassIdentifier:
  itemId: 356
  indentLevel: 0
  storyText: 数道雷劫依次劈下，第八道雷劫带来的压迫力远超之前。白帝稳坐其中，身上的护罩不断明灭，却也始终没有破开。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 0}
  AvatarIntID: 0
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 1
