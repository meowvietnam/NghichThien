  m_Name:
  m_EditorClassIdentifier:
  itemId: 301
  indentLevel: 1
  storyText: 林沐雪看到你的出现先是有些戒备，似乎是想起前日于此有一面之缘，这才放松下来。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 0}
  AvatarIntID: 0
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
