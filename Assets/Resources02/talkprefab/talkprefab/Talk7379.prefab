  m_EditorClassIdentifier:
  itemId: 1241
  indentLevel: 0
  storyText: 宫主！老朽徒儿向来坚守道心，定然不会以邪术突破，肯定是他满口胡言！
  description:
  AvatarIDSetType: 0
