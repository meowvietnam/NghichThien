  m_Name:
  m_EditorClassIdentifier:
  itemId: 1184
  indentLevel: 0
  storyText: 小友既身怀林家秘宝，想必是深受林家信任，便与本宫一同去林家吧。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 114085432568156849}
