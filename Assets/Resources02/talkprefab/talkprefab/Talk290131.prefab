  m_Name:
  m_EditorClassIdentifier:
  itemId: 500
  indentLevel: 0
  storyText: '{$daoyou}看来是不知道此事呀，他们百里家啊，就是靠着倒卖海外来的这些货物在宁州发家的嘛，而且和海上的商会还颇有渊源呐。'
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 114315998945265487}
  AvatarIntID: 0
