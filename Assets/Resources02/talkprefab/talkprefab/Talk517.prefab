  m_Name:
  m_EditorClassIdentifier:
  itemId: 1102
  indentLevel: 1
  storyText: 再者，剑宗讲究一鼓作气，灵气的爆发也是相当重要，故而{color=#d0380a}纵地金光{/color}与{color=#d0380a}刺穴{/color}也是不二之选。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 114200824738645751}
  AvatarIntID: 0
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 1
  waitForClick: 1
  stopVoiceover: 1
  waitForVO: 0
  setSayDialog: {fileID: 0}
--- !u!114 &114075539364013257
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1884591748779015}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cbdfddbb1a7e9dedeeccda6985376314, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  itemId: 2846
  indentLevel: 1
  storyText: 纯粹的攻防也需要纯粹的灵根作为支撑。若你灵根不纯，则需要修炼{color=#d0380a}天晶诀{/color}，否则也是寸步难行。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 114200824738645751}
  AvatarIntID: 0
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 1
  waitForClick: 1
  stopVoiceover: 1
  waitForVO: 0
  setSayDialog: {fileID: 0}
