  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cbdfddbb1a7e9dedeeccda6985376314, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  itemId: 347
  indentLevel: 0
  storyText: 那魔修所种植的万象花日前我已派人铲除，先前的供奉也都分发了丹药及补偿。我连家依旧会广纳贤士，相信假以时日，无尽之海上传播的便不会再是千流岛的凶名。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 1465
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
