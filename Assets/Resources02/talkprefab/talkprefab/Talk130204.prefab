  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cbdfddbb1a7e9dedeeccda6985376314, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  itemId: 320
  indentLevel: 0
  storyText: 唐家更注重培养族内弟子的想法其实没有错，抛开我的身份而言，我更欣赏唐家。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 114340340516871651}
  AvatarIntID: 1
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
