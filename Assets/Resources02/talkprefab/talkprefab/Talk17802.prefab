  m_EditorClassIdentifier:
  itemId: 314
  indentLevel: 0
  storyText: 黑衣人满意地笑了笑，从袖中掏出情报玉简，随意一挥，便传到恒如手中。
  description:
  AvatarIDSetType: 0
