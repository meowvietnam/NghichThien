--- !u!114 &114242826076828965
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1028606785578569}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cbdfddbb1a7e9dedeeccda6985376314, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  itemId: 1196
  indentLevel: 0
  storyText: 啊，对了，几大魔教最近动作不小，你在外游历时多加小心，我感觉，他们可能会冲着你来。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 114403786171211455}
  AvatarIntID: 0
