  m_Name:
  m_EditorClassIdentifier:
  itemId: 1176
  indentLevel: 0
  storyText: 摊上你这么个聪慧的宫主，星宫弟子们还真是走运呢。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 114403786171211455}
