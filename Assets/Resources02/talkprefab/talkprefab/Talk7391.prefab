  m_Name:
  m_EditorClassIdentifier:
  itemId: 1186
  indentLevel: 0
  storyText: 噗，好好好，我把《星辰神念体》也教你吧，这可是我父亲的独门神通，宁州只此一份。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 114403786171211455}
  AvatarIntID: 1
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
