  indentLevel: 0
--- !u!114 &114356031473287461
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1028606785578569}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cbdfddbb1a7e9dedeeccda6985376314, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  itemId: 1175
  indentLevel: 0
  storyText: 他有啥可怜的，真要我坐镇宫中处理事务，肯定还不如鸾儿。这样既承担了宫主的责任，又能让我外出游山玩水，可是双赢哦。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 114403786171211455}
  AvatarIntID: 1
