  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cbdfddbb1a7e9dedeeccda6985376314, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  itemId: 1178
  indentLevel: 0
  storyText: 啊对了，这个丹方给你，还有些对应的药材。然后之前鸾儿给过你《神交法》，这本《内照法》也一起给你吧。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 114403786171211455}
  AvatarIntID: 1
