  m_EditorClassIdentifier:
  itemId: 506
  indentLevel: 0
  storyText: 真正能全身而退的，仅有现在飘在海上的两人。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 0}
  AvatarIntID: 0
