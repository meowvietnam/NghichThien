  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cbdfddbb1a7e9dedeeccda6985376314, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  itemId: 363
  indentLevel: 0
  storyText: 你虽被树根困住不知外界情况，但也不难猜到几分。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
