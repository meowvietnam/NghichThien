  m_Name:
  m_EditorClassIdentifier:
  itemId: 409
  indentLevel: 0
  storyText: 你虽被树根困住不知外界情况，但也不难猜到几分。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 0
