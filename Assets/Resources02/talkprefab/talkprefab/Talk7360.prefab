  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cbdfddbb1a7e9dedeeccda6985376314, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  itemId: 416
  indentLevel: 0
  storyText: 在你回想时，扎根于你的树根也是被斩断，让你得以观察战场的情况。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
