  m_Name:
  m_EditorClassIdentifier:
  itemId: 423
  indentLevel: 0
  storyText: 你只能拼命吸收附近的灵气，然后借此催动护体神通，企图从接下来的攻击中存活。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
