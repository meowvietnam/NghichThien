  m_Name:
  m_EditorClassIdentifier:
  itemId: 418
  indentLevel: 0
  storyText: 往左看...往右看...往上看...甚至是神识探查地底..都不见那半透明的残魂...都没有魏无极的身影。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 0
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
