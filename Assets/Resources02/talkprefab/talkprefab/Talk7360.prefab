  m_EditorClassIdentifier:
  itemId: 457
  indentLevel: 0
  storyText: 一时是剑气破空之音四起，树根挥舞之声跌伏。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 0
