  m_Name:
  m_EditorClassIdentifier:
  itemId: 472
  indentLevel: 0
  storyText: 炼器是一门将不同五维特性、不同阴阳属性、不同五行属性的材料融合在一起成器的法门。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 114000065509268338}
  AvatarIntID: 0
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
