  m_Name:
  m_EditorClassIdentifier:
  itemId: 390
  indentLevel: 0
  storyText: （冷静地）我便是她二姐，敢问阁下是何人？为何来此？
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 114797289880027165}
