  m_Name:
  m_EditorClassIdentifier:
  itemId: 410
  indentLevel: 0
  storyText: 气眼中央，一位通体漆黑、发色雪白的“少女”本在闭目修炼。你闯入气眼后，她便也抬头看向了你。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 0
