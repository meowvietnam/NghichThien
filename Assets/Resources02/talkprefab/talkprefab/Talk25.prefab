  m_EditorClassIdentifier:
  itemId: 332
  indentLevel: 0
  storyText: 循着声音望去，一位身材娇小的黄衣女修与一位面容秀美的蓝袍女修发生了争执。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
