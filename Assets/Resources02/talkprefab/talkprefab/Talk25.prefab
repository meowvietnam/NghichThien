  m_Name:
  m_EditorClassIdentifier:
  itemId: 482
  indentLevel: 0
  storyText: 想来除去境内遇险弟子，所有人都传送而出。清点人数后请诸位小友以自身灵气激活天魔令上的印记，静候本派弟子前去记录。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 9
