  m_Name:
  m_EditorClassIdentifier:
  itemId: 286
  indentLevel: 0
  storyText: 这到底是什么人，出手看起来毫无章法可言，用来用去也只会一两个招式，威力倒是不凡。
  description:
  AvatarIDSetType: 0
