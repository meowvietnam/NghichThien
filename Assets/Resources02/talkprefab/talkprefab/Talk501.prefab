  m_Name:
  m_EditorClassIdentifier:
  itemId: 219
  indentLevel: 1
  storyText: 有老夫在，你怕甚么？你这{xiaozi}资质平平，根基又差，不多吃点天才地宝的补补，以后想{color=#d0380a}筑基{/color}都难。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 114946187578883155}
  AvatarIntID: 2
  character: {fileID: 0}
  portrait: {fileID: 0}
