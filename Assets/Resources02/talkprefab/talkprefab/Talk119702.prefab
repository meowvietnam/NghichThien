  indentLevel: 1
  text: 关于宁州的修仙宗门
  VarText: {fileID: 0}
  description:
  targetBlock: {fileID: 114974839126671005}
  hideIfVisited: 0
  interactable:
    booleanRef: {fileID: 0}
    booleanVal: 1
