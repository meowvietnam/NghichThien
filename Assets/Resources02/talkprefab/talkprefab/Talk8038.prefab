  m_Name:
  m_EditorClassIdentifier:
  itemId: 668
  indentLevel: 0
  storyText: 本门炼器大会既是为了精进门下弟子炼器之道，也是为了补充宗门制式法器。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 114172720814663372}
