  m_EditorClassIdentifier:
  itemId: 311
  indentLevel: 0
  storyText: 你一个炼气期的{xiaozi}，他必然不会在意，等时机一到，你便服下这颗丹药，偷袭于他，定能见效。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 114256675112714775}
  AvatarIntID: 0
