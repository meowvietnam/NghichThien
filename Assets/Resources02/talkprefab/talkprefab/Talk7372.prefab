  m_Name:
  m_EditorClassIdentifier:
  itemId: 300
  indentLevel: 1
  storyText: 小友，你来了。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 114823084727816202}
  AvatarIntID: 1631
  character: {fileID: 0}
  portrait: {fileID: 0}
