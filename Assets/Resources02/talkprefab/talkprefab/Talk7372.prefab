  m_Name:
  m_EditorClassIdentifier:
  itemId: 317
  indentLevel: 0
  storyText: 但我适时出现在了林府。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 114823084727816202}
  AvatarIntID: 1
  character: {fileID: 0}
  portrait: {fileID: 0}
