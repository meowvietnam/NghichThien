  m_Name:
  m_EditorClassIdentifier:
  itemId: 313
  indentLevel: 0
  storyText: 呵呵，那就得先说说宁州几大家族年轻一辈的大少爷了。百里家那位性烈如火，但过于崇尚实力；而公孙家那位举止文雅，却是工于心计；最后倪家的大少爷，虽说贪玩且好管闲事，但因为性格直爽，也是人缘最好的一位。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 114823084727816202}
  AvatarIntID: 1
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
