  m_Name:
  m_EditorClassIdentifier:
  itemId: 387
  indentLevel: 0
  storyText: '{FirstName}{xiongdi}言重了，碎星岛也非安全之地，未免夜长梦多。把这两瓶驱妖液带上，我们即日便启程前往化龙海域吧！'
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 3006
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
