  m_Name:
  m_EditorClassIdentifier:
  itemId: 338
  indentLevel: 1
  storyText: 前辈，这是我们拍卖行的传音符印记，日后前辈若是想知道最新的拍品情况，直接用{color=#d0380a}传音符{/color}与我们联系便可。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 114880057215695354}
  AvatarIntID: 917
