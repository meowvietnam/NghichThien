  m_Name:
  m_EditorClassIdentifier:
  itemId: 423
  indentLevel: 0
  storyText: 你将{$fysl1}株{SayStcVal=940}添入了丹炉之中，然后便马不停蹄地继续扇起了火来...
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 114772800456527652}
  AvatarIntID: 0
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 1
  waitForClick: 1
  stopVoiceover: 1
  waitForVO: 0
