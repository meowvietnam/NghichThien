  m_Name:
  m_EditorClassIdentifier:
  itemId: 356
  indentLevel: 1
  storyText: 这气息似曾相识...待我仔细想想。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 2
  character: {fileID: 0}
  portrait: {fileID: 0}
