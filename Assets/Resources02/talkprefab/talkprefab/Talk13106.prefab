  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cbdfddbb1a7e9dedeeccda6985376314, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  itemId: 1594
  indentLevel: 0
  storyText: 这天元神丹在化神期服用能大大提升修为，对{$MasterDaoyou}一定大有裨益。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 114610092500478472}
