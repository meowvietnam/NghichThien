  m_Name:
  m_EditorClassIdentifier:
  itemId: 1636
  indentLevel: 0
  storyText: 希望{$MasterDaoyou}能好好加以利用，若能对你的飞升起到帮助，就再好不过了。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 114610092500478472}
