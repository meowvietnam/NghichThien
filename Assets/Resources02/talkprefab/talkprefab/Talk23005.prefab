  m_EditorClassIdentifier:
  itemId: 366
  indentLevel: 0
  storyText: "正阳山呼啸的风不知什么时候止了，残阳如血，照在云秋兰满面的阴霾上，你一时竟看不清她的神情。\r\n"
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 0
