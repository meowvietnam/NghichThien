  m_Name:
  m_EditorClassIdentifier:
  itemId: 1362
  indentLevel: 0
  storyText: 这天魔可没传说中那么厉害，我随手便把它解决了。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 114986904815141622}
  AvatarIntID: 1
