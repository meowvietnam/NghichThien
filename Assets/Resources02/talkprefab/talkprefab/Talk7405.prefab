  m_EditorClassIdentifier:
  itemId: 1337
  indentLevel: 0
  storyText: 但这些都不足以让你对它产生畏惧！{vpunch=10,0.5}
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 0}
  AvatarIntID: 1
