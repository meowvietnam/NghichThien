  m_Name:
  m_EditorClassIdentifier:
  itemId: 234
  indentLevel: 0
  storyText: 即便是解释为想验证一下刚从玉简中看到的秘术思路，今天也难以脱身。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 114598609627697552}
