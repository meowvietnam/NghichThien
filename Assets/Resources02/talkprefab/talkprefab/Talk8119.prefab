  m_Name:
  m_EditorClassIdentifier:
  itemId: 226
  indentLevel: 0
  storyText: 好在秘阁平时难有修士叨扰，也未招来什么麻烦。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 0}
  AvatarIntID: 0
  character: {fileID: 0}
  portrait: {fileID: 0}
