  m_Name:
  m_EditorClassIdentifier:
  itemId: 434
  indentLevel: 0
  storyText: 老头曾说过，这柄剑是他在宁州古迹中找到的。当年在古迹中还发生过什么值得注意的事么？
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 1
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
