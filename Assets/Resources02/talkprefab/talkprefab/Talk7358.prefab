  m_EditorClassIdentifier:
  itemId: 343
  indentLevel: 0
  storyText: 对于倪旭欣而言，这轻微的颤抖所带来的震撼无异于受古树本体全力一击！
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 0
