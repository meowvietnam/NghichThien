  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cbdfddbb1a7e9dedeeccda6985376314, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  itemId: 344
  indentLevel: 0
  storyText: 这可是化神后期修士白帝！这可是宁州乃至九州第一剑修白帝！这可是能护宁州安定的白帝楼楼主白帝！
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
