  m_Name:
  m_EditorClassIdentifier:
  itemId: 1271
  indentLevel: 0
  storyText: 大胆，哪有你多嘴的份！
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 2239
  character: {fileID: 0}
  portrait: {fileID: 0}
