--- !u!114 &114284453992269896
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1978153537373109}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cbdfddbb1a7e9dedeeccda6985376314, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  itemId: 1282
  indentLevel: 0
  storyText: 小友境界虽有不足，实力却很不错，但在我星宫出手，甚至打伤两位长老，想必目的不会是这么简单吧？
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 114523241426649246}
  AvatarIntID: 2243
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
