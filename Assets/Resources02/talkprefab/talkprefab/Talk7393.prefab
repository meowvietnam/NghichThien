  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cbdfddbb1a7e9dedeeccda6985376314, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  itemId: 1267
  indentLevel: 0
  storyText: 当年你徒儿要当众格杀我这晚辈时，没见你加以阻拦。今日我击败他，却又在此饶舌。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 1
