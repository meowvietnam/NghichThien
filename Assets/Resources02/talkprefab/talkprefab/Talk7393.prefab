  m_Name:
  m_EditorClassIdentifier:
  itemId: 1299
  indentLevel: 0
  storyText: 冲虚的情况的确不合常理，符合小友的怀疑。此事本宫会亲自调查，待事了之后给林家一个说法。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 114523241426649246}
  AvatarIntID: 2243
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
