  m_GameObject: {fileID: 1978153537373109}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cbdfddbb1a7e9dedeeccda6985376314, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  itemId: 1357
  indentLevel: 0
  storyText: 只是他在突破时用了什么邪术就不得而知了。
