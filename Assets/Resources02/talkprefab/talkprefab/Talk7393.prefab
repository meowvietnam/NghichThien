  m_Name:
  m_EditorClassIdentifier:
  itemId: 1372
  indentLevel: 0
  storyText: 若换做是无惑你寿元将尽，且无法突破瓶颈，又会作何选择呢？
  description:
  AvatarIDSetType: 1
