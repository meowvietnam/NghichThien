  m_Name:
  m_EditorClassIdentifier:
  itemId: 481
  indentLevel: 2
  storyText: 道友去{color=#d0380a}逸风城宝器轩{/color}看看吧，那边法器不少，可以去挑几件趁手的。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 1131
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
