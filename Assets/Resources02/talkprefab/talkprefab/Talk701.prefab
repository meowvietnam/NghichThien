  m_Name:
  m_EditorClassIdentifier:
  itemId: 389
  indentLevel: 0
  storyText: "随着几个落石正中身体，那修士顿时失去平衡，直直向地面坠去，只\r见公孙季轻挥纸扇，用灵力将其托举，轻轻扶到地上。"
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 0}
  AvatarIntID: 0
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
