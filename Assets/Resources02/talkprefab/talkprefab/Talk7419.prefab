  m_Name:
  m_EditorClassIdentifier:
  itemId: 160
  indentLevel: 0
  storyText: 据我所知，星宫主与那白帝素无交情。你当真要为了他与我古神教为敌？
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 114393776122040446}
