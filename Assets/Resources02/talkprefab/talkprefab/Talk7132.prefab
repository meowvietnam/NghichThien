  m_Name:
  m_EditorClassIdentifier:
  itemId: 188
  indentLevel: 0
  storyText: 依道友所见，我这剑法如何？
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 114007840769784115}
  AvatarIntID: 0
