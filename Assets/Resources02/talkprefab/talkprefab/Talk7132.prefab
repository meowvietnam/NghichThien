  m_Name:
  m_EditorClassIdentifier:
  itemId: 221
  indentLevel: 0
  storyText: 那日我和往常一样，独自在碧悠潭练着剑，突然却听到有两人的对谈之声。
  description:
  AvatarIDSetType: 1
