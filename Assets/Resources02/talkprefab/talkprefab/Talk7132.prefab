  m_Name:
  m_EditorClassIdentifier:
  itemId: 211
  indentLevel: 0
  storyText: 此事我倒还未曾向他人提起，不过今日难得打的尽兴，与{$TmpTalkString}说说也无妨。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 114007840769784115}
