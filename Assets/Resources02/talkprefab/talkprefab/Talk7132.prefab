  m_EditorClassIdentifier:
  itemId: 182
  indentLevel: 1
  storyText: 我名叫{FirstName}{LastName}，见温兄剑招舞的高明，不由自主便想与你切磋一二。
  description:
  AvatarIDSetType: 0
