  m_Name:
  m_EditorClassIdentifier:
  itemId: 209
  indentLevel: 0
  storyText: 奇遇？那我可就感兴趣了，温兄可有兴致与我说上一二？
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 114007840769784115}
