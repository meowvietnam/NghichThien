--- !u!114 &114873252684228739
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1299494979751304}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cbdfddbb1a7e9dedeeccda6985376314, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  itemId: 226
  indentLevel: 0
  storyText: 说不定总有一日，我们也可以修炼到他们那样的境界。到时候，你一定能够再见到那两位前辈的。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 114007840769784115}
