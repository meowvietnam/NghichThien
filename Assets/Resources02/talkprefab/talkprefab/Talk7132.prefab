  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1299494979751304}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cbdfddbb1a7e9dedeeccda6985376314, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  itemId: 208
  indentLevel: 0
  storyText: 我会修炼这竹山剑法，说来倒也是因为有过一番奇遇。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 114007840769784115}
  AvatarIntID: 0
