  m_Name:
  m_EditorClassIdentifier:
  itemId: 277
  indentLevel: 0
  storyText: 数月前，正阳山遭遇了近年最大的推山兽兽潮。为防止后山各驻地受灾，我与秋兰等人奉命率百余外门弟子前来镇守。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 517
