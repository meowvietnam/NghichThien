--- !u!114 &114276291974233707
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1726053315175453}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cbdfddbb1a7e9dedeeccda6985376314, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  itemId: 320
  indentLevel: 0
  storyText: 诸位道友，情况危急！我们兵分三路，一路去帮助澹师姐维持阵法，一路随我准备杀阵，剩下的人见机行事，随时支援，如何？
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 530
  character: {fileID: 0}
