  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1726053315175453}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cbdfddbb1a7e9dedeeccda6985376314, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  itemId: 358
  indentLevel: 0
  storyText: "你遁至高空，往下俯瞰，好一番炼狱景象！炼气期的妖兽自破洞处鱼贯而入，与外门弟子战作一团。高阶妖兽则向着澹台仙和云秋兰两边冲去。\r\n"
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
