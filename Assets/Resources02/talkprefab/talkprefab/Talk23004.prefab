  m_Name:
  m_EditorClassIdentifier:
  itemId: 298
  indentLevel: 0
  storyText: 经过我们近日的研判，为了防止情况进一步失控，我们必须先发制人，恶战在所难免。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 517
