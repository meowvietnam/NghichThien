  m_Name:
  m_EditorClassIdentifier:
  itemId: 360
  indentLevel: 0
  storyText: "你施展遁术，尽力躲避着敌人。然而，早已有妖兽注意到了你的存在，试图将你拦截。\r\n"
  description:
  AvatarIDSetType: 0
