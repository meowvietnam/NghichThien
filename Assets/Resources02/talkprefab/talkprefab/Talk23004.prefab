  m_Name:
  m_EditorClassIdentifier:
  itemId: 354
  indentLevel: 0
  storyText: "云秋兰飞身向前，以迅雷不及掩耳之势挡在一位还未反应过来的同门身前，与凶兽缠斗在一起。\r\n"
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 0
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
