  m_Name:
  m_EditorClassIdentifier:
  itemId: 299
  indentLevel: 0
  storyText: 澹台仙神秘地笑了笑，看向了一旁的云秋兰，云秋兰向你施了一礼。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 0
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
