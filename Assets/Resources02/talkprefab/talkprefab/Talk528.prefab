  m_Name:
  m_EditorClassIdentifier:
  itemId: 324
  indentLevel: 0
  storyText: 我派长老按职责不同，分为授业长老，外务长老，炼丹、炼器长老以及挂名长老。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 114426319830450236}
