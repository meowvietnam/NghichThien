MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1301764080773148}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cbdfddbb1a7e9dedeeccda6985376314, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  itemId: 376
  indentLevel: 2
  storyText: 如果我没猜错的话，这里是一处独立的结界空间，我们看到的是石廊和石人都只不过是掩人耳目的表象罢了。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 2
