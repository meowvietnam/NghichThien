  m_Name:
  m_EditorClassIdentifier:
  itemId: 924
  indentLevel: 0
  storyText: 在藏经阁呆了许久的一行人来到宗门大殿，掌门以及先前去现场勘查的长老已经在大殿内等待。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 0
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
