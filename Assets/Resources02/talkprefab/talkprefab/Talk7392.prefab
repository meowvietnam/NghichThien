  m_Name:
  m_EditorClassIdentifier:
  itemId: 1158
  indentLevel: 0
  storyText: 啊！差点忘了，我还要去给鸾儿疗伤呢！
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 114768555835351507}
