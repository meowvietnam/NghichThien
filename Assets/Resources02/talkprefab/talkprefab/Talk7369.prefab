  m_Name:
  m_EditorClassIdentifier:
  itemId: 308
  indentLevel: 0
  storyText: 情急之下，你收捏法诀就准备驱使神通发动攻击。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
