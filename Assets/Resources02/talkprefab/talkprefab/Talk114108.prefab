  m_Name:
  m_EditorClassIdentifier:
  itemId: 383
  indentLevel: 0
  storyText: 灵脉遭到污染，附近的妖兽与人类也被魔气侵蚀魔化，当时的几大修真门派付出了很大的代价，才将这处魔地封印起来，阻止了魔气的进一步扩散。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 114544654268018149}
  AvatarIntID: 301
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
