  m_EditorClassIdentifier:
  itemId: 1012
  indentLevel: 0
  storyText: 众人窝在藏经阁内近一月，期间在一起交换了几次信息，但大都是不怎么有用的内容。
  description:
  AvatarIDSetType: 0
