--- !u!114 &114238376733816982
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1056403782639390}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cbdfddbb1a7e9dedeeccda6985376314, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  itemId: 265
  indentLevel: 4
  storyText: 除了他们，还有数人受你所邀。遁光道道，他们从四面八方陆续赶来，在离你稍近的地方观礼。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 0}
  AvatarIntID: 0
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 1
  waitForClick: 1
  stopVoiceover: 1
  waitForVO: 0
  setSayDialog: {fileID: 0}
--- !u!114 &114093989802069119
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1056403782639390}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cbdfddbb1a7e9dedeeccda6985376314, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  itemId: 267
  indentLevel: 4
  storyText: 除了他们，就只剩你一人在这风暴的中心，独自对抗天降的雷劫。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 0}
  AvatarIntID: 0
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 1
  waitForClick: 1
  stopVoiceover: 1
  waitForVO: 0
  setSayDialog: {fileID: 0}
--- !u!114 &114443373709054430
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1056403782639390}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cbdfddbb1a7e9dedeeccda6985376314, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  itemId: 275
  indentLevel: 0
  storyText: 以你为中心，附近所有的修士都被天地异象所吸引。他们不敢靠近，只能远远的围观。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 0}
  AvatarIntID: 0
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 1
  waitForClick: 1
  stopVoiceover: 1
  waitForVO: 0
  setSayDialog: {fileID: 0}
