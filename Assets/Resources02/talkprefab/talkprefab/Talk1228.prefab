  stopVoiceover: 1
  waitForVO: 0
  setSayDialog: {fileID: 0}
--- !u!114 &114044575347184542
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1163648692121667}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cbdfddbb1a7e9dedeeccda6985376314, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  itemId: 381
  indentLevel: 1
  storyText: 你本以为这里会充斥着市井般的哄闹声，但与猜测不同，丝竹管弦奏响的雅致曲调伴着素馨的熏香弥散开。透过青萝垂成的蔓帘你隐约看到几桌吃茶的客人，比起风月场所此处更像是别致的茶楼。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 0}
  AvatarIntID: 0
