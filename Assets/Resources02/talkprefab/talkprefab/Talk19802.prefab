  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cbdfddbb1a7e9dedeeccda6985376314, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  itemId: 466
  indentLevel: 0
  storyText: 呵，玄骨以为这魔神蛊就能完全控制我？这麒麟血我必不能让他如愿以偿。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 114295934800620344}
  AvatarIntID: 0
