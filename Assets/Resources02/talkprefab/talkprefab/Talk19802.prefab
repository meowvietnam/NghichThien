  m_Name:
  m_EditorClassIdentifier:
  itemId: 469
  indentLevel: 0
  storyText: 但是，以精血铭刻灵纹在身上习得一些妖兽神通却有可能。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 114295934800620344}
