  m_Name:
  m_EditorClassIdentifier:
  itemId: 258
  indentLevel: 0
  storyText: 刚刚你走了没多久，我便发现那些原本静止不动的根须开始慢慢朝着我们移动。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 2
