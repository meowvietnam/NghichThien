  m_Name:
  m_EditorClassIdentifier:
  itemId: 261
  indentLevel: 0
  storyText: 令人在不知不觉中陷入幻觉，随后再用根须扎根将他们身上的灵气抽干。对于境界稍低之人，甚至能直接灌输大道感悟，令其神魂失守。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 1
