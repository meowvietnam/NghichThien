  m_Name:
  m_EditorClassIdentifier:
  itemId: 249
  indentLevel: 1
  storyText: 我遇到的第二个幻象，用的似乎是金虹剑派的招法。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 1
