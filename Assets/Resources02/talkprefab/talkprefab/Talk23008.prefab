  m_Name:
  m_EditorClassIdentifier:
  itemId: 498
  indentLevel: 0
  storyText: 救出掌教真人和你的父母，有了他们三人的力量，再来几个恒如也不是对手了。
  description:
  AvatarIDSetType: 0
