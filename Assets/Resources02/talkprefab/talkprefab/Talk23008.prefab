  m_Name:
  m_EditorClassIdentifier:
  itemId: 497
  indentLevel: 0
  storyText: 呵，秘术中的引力之法，他能不垂涎三尺吗，更别说还有秘境里的宝物了。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
