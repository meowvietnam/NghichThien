--- !u!114 &114403953502056510
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1518245159041833}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cbdfddbb1a7e9dedeeccda6985376314, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  itemId: 509
  indentLevel: 0
  storyText: 谁也没想到，阴错阳差下，他居然触发了秘境的禁制，掌教真人赶到的时候，堕山大圣已经几乎被抽干了。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 530
