  m_Name:
  m_EditorClassIdentifier:
  itemId: 488
  indentLevel: 0
  storyText: 推山兽一族的堕山大圣为躲避古神教的神识追踪，被我教安置在秘境外围休养。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 530
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
