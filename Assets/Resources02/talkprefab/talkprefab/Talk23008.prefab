  m_Name:
  m_EditorClassIdentifier:
  itemId: 317
  indentLevel: 0
  storyText: 你向前走去，看到桌上摆满了她已经找出的玉简。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 0
