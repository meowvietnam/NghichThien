  m_Name:
  m_EditorClassIdentifier:
  itemId: 263
  indentLevel: 0
  storyText: 枯木师弟，你我已有五百余年未见了吧？自我劝阻你修习枯木功之后...
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 114135744513948794}
  AvatarIntID: 261
  character: {fileID: 0}
  portrait: {fileID: 0}
