  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1054201233071627}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cbdfddbb1a7e9dedeeccda6985376314, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  itemId: 302
  indentLevel: 0
  storyText: 还是交由掌门吧，我已经通知他了。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 114135744513948794}
  AvatarIntID: 261
  character: {fileID: 0}
