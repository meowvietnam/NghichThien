  m_Name:
  m_EditorClassIdentifier:
  itemId: 271
  indentLevel: 0
  storyText: 明山似乎是不想继续聊下去，也可能不想再被认为自己高高在上，没有接话，而是将目光转向了你。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 0}
  AvatarIntID: 261
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 1
  waitForClick: 1
  stopVoiceover: 1
  waitForVO: 0
  setSayDialog: {fileID: 0}
