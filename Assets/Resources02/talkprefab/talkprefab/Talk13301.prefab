  m_EditorClassIdentifier:
  itemId: 350
  indentLevel: 0
  storyText: 不错{shidi}，看来你已经领取了入门的功法，至于其他的基础法术，你可以多多向外门的传功长老请教。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 114356296411290796}
