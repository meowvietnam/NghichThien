  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cbdfddbb1a7e9dedeeccda6985376314, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  itemId: 402
  indentLevel: 0
  storyText: 没想到此行竟如此凶险，还好{shidi}你能平安归来。
