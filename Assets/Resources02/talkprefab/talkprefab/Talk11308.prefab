  m_Name:
  m_EditorClassIdentifier:
  itemId: 484
  indentLevel: 0
  storyText: 青蛇前辈乃是本门供奉，亦是本派最年轻的金丹期修士，自创功法《青蛇劲》，乃我派毒术大师。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 207
