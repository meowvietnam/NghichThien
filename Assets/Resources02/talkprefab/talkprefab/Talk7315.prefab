  m_Name:
  m_EditorClassIdentifier:
  itemId: 330
  indentLevel: 0
  storyText: 虽然恒如生性贪婪，但毕竟师徒一场，也教过你不少东西。到真要下手时，你却是迟疑了。
  description:
  AvatarIDSetType: 1
