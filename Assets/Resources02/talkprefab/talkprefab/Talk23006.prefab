  m_EditorClassIdentifier:
  itemId: 359
  indentLevel: 0
  storyText: 跟我来吧，屋里有很强的引力禁制，我没有办法解除，但是用宝环能庇护我们进去。
  description:
  AvatarIDSetType: 0
