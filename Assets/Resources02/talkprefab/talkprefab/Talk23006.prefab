  m_Name:
  m_EditorClassIdentifier:
  itemId: 243
  indentLevel: 0
  storyText: "山不高而青，水不深而秀，花不多而艳，竹不密而屏，室不宽而雅，外有翠竹隐隐，内有小院泥轩，真是幽深僻静，令人心旷神怡。\r\n"
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 0
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
