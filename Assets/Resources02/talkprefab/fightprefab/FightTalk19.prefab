  m_Name:
  m_EditorClassIdentifier:
  itemId: 1175
  indentLevel: 0
  storyText: 不好啦掌门，血剑宫打来了！
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 114164102752502240}
  AvatarIntID: 0
