  waitForVO: 0
  setSayDialog: {fileID: 0}
--- !u!114 &114835128299054372
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1537142217898949}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cbdfddbb1a7e9dedeeccda6985376314, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  itemId: 1184
  indentLevel: 0
  storyText: 我抽调几个金丹长老前来镇守，你们一定要守住，待我们消灭剑魔，便可以带金虹神剑前来支援！
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 114580912584480604}
