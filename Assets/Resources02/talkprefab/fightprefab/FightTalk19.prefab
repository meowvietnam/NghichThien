  m_Name:
  m_EditorClassIdentifier:
  itemId: 1174
  indentLevel: 0
  storyText: 你跑进来干什么！此地极为危险，快出去！
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 114580912584480604}
