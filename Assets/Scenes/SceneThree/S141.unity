  m_Name:
  m_EditorClassIdentifier:
  itemId: 330
  indentLevel: 0
  storyText: 两位师妹，依我看不如让这位小友自己选择拜入哪派，你们看如何？
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
