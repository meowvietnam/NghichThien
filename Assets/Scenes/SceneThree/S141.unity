  m_EditorClassIdentifier:
  itemId: 902
  indentLevel: 1
  storyText: 师尊，本届的宗门大比的结果出来了，这次夺魁的是{FirstName}{LastName}{shidi}。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
