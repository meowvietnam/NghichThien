  m_Name:
  m_EditorClassIdentifier:
  itemId: 326
  indentLevel: 0
  storyText: 你侧目一看，玄伶仙子指尖凝气，一寸蓝芒似剑刃般聚于指上。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 0}
  AvatarIntID: 0
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
