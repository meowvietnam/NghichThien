  m_Name:
  m_EditorClassIdentifier:
  itemId: 325
  indentLevel: 0
  storyText: 雕虫小技，不过尔尔罢了。若是想先一步踏入仙途，自然应当入剑派修行。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
