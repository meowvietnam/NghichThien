  m_Name:
  m_EditorClassIdentifier:
  itemId: 608
  indentLevel: 1
  storyText: 之后我就顺势激他出手即可。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 1
  character: {fileID: 0}
  portrait: {fileID: 0}
