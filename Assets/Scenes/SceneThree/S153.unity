  m_Name:
  m_EditorClassIdentifier:
  itemId: 823
  indentLevel: 0
  storyText: 无妨，你且回石窟继续测试其他修士，这位{shidi}交给我就可以了。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
