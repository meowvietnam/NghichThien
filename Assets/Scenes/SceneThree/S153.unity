  m_Name:
  m_EditorClassIdentifier:
  itemId: 824
  indentLevel: 0
  storyText: 好不容易有位{shidi}通过测试，我赶着带{ta}面见师姐故还未曾测过，望师姐谅解。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 521
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
