  m_EditorClassIdentifier:
  itemId: 71
  indentLevel: 0
  storyText: '{color=#d0380a}通羽{/color}长老可能知道些内情，他一贯疼爱我，从他这里说不定可以获得一些有用的信息。'
  description:
