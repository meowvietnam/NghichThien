  m_Script: {fileID: 11500000, guid: cbdfddbb1a7e9dedeeccda6985376314, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  itemId: 1192
  indentLevel: 0
  storyText: 但...但宫主此前在与我一同追杀...冲...冲虚散人时，被这叛徒引入古神教的大阵中，身...身死道消了...
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 449}
  AvatarIntID: 614
