  m_Name:
  m_EditorClassIdentifier:
  itemId: 1155
  indentLevel: 0
  storyText: 星宫出了如此变故，需要商谈一番应对之策，道友若有兴趣可以留下旁听。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 290}
  AvatarIntID: 0
