  m_EditorClassIdentifier:
  itemId: 1453
  indentLevel: 0
  storyText: 重铸的任务开始之后，需要定期组织巡逻，清除妖兽魔物等，以防它们侵入驻地。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 700}
  AvatarIntID: 0
