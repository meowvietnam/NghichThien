  m_Name:
  m_EditorClassIdentifier:
  itemId: 317
  indentLevel: 0
  storyText: '{color=#d0380a}思绪{/color}嘛，通常是经年累月灵光一现时，偶有所得，亦或是与人论道时，有所收获。'
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 2
