  m_Name:
  m_EditorClassIdentifier:
  itemId: 303
  indentLevel: 0
  storyText: '{color=#d0380a}突破{/color}便是对已习得的功法进行进一步精进。能显著提升战斗时的效能，熟能生巧，精进功法也会不断地提升对该大道的感悟。'
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 2
