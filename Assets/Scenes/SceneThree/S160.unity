  m_Name:
  m_EditorClassIdentifier:
  itemId: 310
  indentLevel: 0
  storyText: "无论行为如何，都会{color=#d0380a}每月{/color}按主修功法获得修为，而闭关选择{color=#d0380a}修炼{/color}行为时则可以受到诸项加成，修为获取效率更高。\n"
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 0
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
