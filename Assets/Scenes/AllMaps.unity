  m_EditorClassIdentifier:
  itemId: 350
  indentLevel: 0
  storyText: '{FirstName}{gongzi}不必担心，不过是些落单魔修，料想是刚好在附近而已。'
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 616
