  m_Name:
  m_EditorClassIdentifier:
  itemId: 357
  indentLevel: 0
  storyText: 在场各大家族少主，门派首徒等或是出言同意，或是沉默不语，一时间倒是也没人站出来反对。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 0}
  AvatarIntID: 10123
