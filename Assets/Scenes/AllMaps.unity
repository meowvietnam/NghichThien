  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 217
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
