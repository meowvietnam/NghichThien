  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cbdfddbb1a7e9dedeeccda6985376314, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  itemId: 349
  indentLevel: 0
  storyText: 我也只是比公孙兄早到一点而已。这附近既然有魔修出现，恐怕此次涵虚仙府出世还是走漏了消息。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 1
