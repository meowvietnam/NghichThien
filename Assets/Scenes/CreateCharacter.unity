--- !u!114 &695508705
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 695508703}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 0.99215686, b: 0.85490197, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: dc144b02d262e8149bf991146baa801e, type: 3}
    m_FontSize: 38
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 3
    m_MaxSize: 40
    m_Alignment: 1
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 0.8
  m_Text: "T\u1EEB x\u01B0a \u0111\u1EBFn nay, m\u1ECDi ng\u01B0\u1EDDi ch\u01B0a
    t\u1EEBng c\xF3 \u0111\xECnh ch\u1EC9 qua \u0111\u1ED1i con \u0111\u01B0\u1EDDng
    tr\u01B0\u1EDDng sinh th\u0103m d\xF2...\nTh\u01B0\u1EE3ng C\u1ED5 th\u1EDDi
    \u0111\u1EA1i \u0110\u1EA1o gia c\xE1c tu s\u0129,\nL\u1EA5y t\u1EF1 th\xE2n
    linh c\u0103n l\xE0m c\u0103n c\u01B0, c\xE2u th\xF4ng thi\xEAn \u0111\u1ECBa
    linh kh\xED,\nD\u1EF1a v\xE0o Th\xE1i C\u1EF1c Ng\u0169 H\xE0nh, \xC2m D\u01B0\u01A1ng
    B\xE1i Qu\xE1i chi l\u1EF1c, b\xEAn ngo\xE0i luy\u1EC7n \u0111an d\u01B0\u1EE3c,
    n\u1ED9i tu Nguy\xEAn Th\u1EA7n,\nL\u01B0u l\u1EA1i v\xF4 s\u1ED1 c\u01B0\u1EDDng
    \u0111\u1EA1i tu ch\xE2n ph\xE1p m\xF4n.\nTruy\u1EC1n thuy\u1EBFt ng\u01B0\u1EDDi
    tu vi cao th\xE2m, li\u1EC1n c\xF3 th\u1EC3 d\u1EABn \u0111\u1ED9ng thi\xEAn
    ki\u1EBFp, ph\xE1 to\xE1i h\u01B0 kh\xF4ng,\nPhi th\u0103ng t\u1EDBi ti\xEAn
    gi\u1EDBi, th\u01B0c s\u1EF1 tr\u1EDF th\xE0nh \u0111\u1ED3ng th\u1ECD c\xF9ng
    tr\u1EDDi \u0111\u1EA5t \"Ti\xEAn nhan\""
