  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CreateCharacter.CharStats.CurrentInfo
  statType: 12
  valueText: {fileID: 1363650042}
  infoName: "Th\u1ECD nguy\xEAn"
  info: "t\xEAn nh\u01B0 \xFD ngh\u0129a ch\xEDnh l\xE0 tu\u1ED5i th\u1ECD c\u1EE7a
    ng\u01B0\u01A1i, b\xECnh th\u01B0\u1EDDng m\xE0 n\xF3i kh\xE1c bi\u1EC7t c\u1EA3nh
    gi\u1EDBi tu s\u0129 th\u1ECD nguy\xEAn kh\xE1c nhau r\u1EA5t l\u1EDBn, nh\u01B0ng
    c\u0169ng c\xF3 c\xE1c lo\u1EA1i thi\xEAn t\xE0i b\u1EA3o c\xF3 th\u1EC3 t\u0103ng
    l\xEAn th\u1ECD nguy\xEAn."
