  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CreateCharacter.CharStats.CurrentInfo
  statType: 12
  valueText: {fileID: 47534338}
  infoName: "Th\u1ECD nguy\xEAn"
  info: "L\xE0 tu\u1ED5i th\u1ECD c\u1EE7a ng\u01B0\u01A1i.\nKhi tu\u1ED5i t\xE1c
    > th\u1ECD nguy\xEAn th\xEC m\u1ED7i hi\u1EC7p l\u1EA7n \u0111\u1EA7u s\u1ED1
    l\u01B0\u1EE3ng h\u1EA5p th\u1EE5 linh kh\xED -2. M\u1ED7i l\u1EA7n s\u1EED d\u1EE5ng
    th\u1EA7n th\xF4ng m\u1EA5t \u0111i 10% sinh m\u1EC7nh v\xE0 c\xF3 50% t\u1EC9
    l\u1EC7 th\u1EA5t b\u1EA1i."
