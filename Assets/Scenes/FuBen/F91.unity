  m_Name:
  m_EditorClassIdentifier:
  itemId: 225
  indentLevel: 0
  storyText: 这一剑看起来像是故意落在牌位上，但此举有什么意义呢。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 3768}
  AvatarIntID: 1
