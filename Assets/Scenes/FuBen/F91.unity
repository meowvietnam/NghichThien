  m_Name:
  m_EditorClassIdentifier:
  itemId: 325
  indentLevel: 0
  storyText: 磔磔，那血剑宫的疯子果然上门找麻烦了，没白费我偷溜进来后暗中设下的拘魂阵。
  description:
  AvatarIDSetType: 0
