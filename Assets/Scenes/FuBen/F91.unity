  m_EditorClassIdentifier:
  itemId: 276
  indentLevel: 0
  storyText: 好。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 3683}
  AvatarIntID: 1
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
