  m_Name:
  m_EditorClassIdentifier:
  itemId: 230
  indentLevel: 1
  storyText: '{$NpcName}见状也不犹豫，手捏法诀，就要驱使法宝攻击阵法。'
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 0}
  AvatarIntID: 0
