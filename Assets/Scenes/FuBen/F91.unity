  m_Script: {fileID: 11500000, guid: cbdfddbb1a7e9dedeeccda6985376314, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  itemId: 228
  indentLevel: 0
  storyText: 而且，那洞府只怕也是在战斗中被夷为平地了。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 3944}
  AvatarIntID: 1
