  m_Name:
  m_EditorClassIdentifier:
  itemId: 244
  indentLevel: 3
  storyText: 损耗并不大，此人破阵的风格可比战斗时的手段柔和多了。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 3683}
