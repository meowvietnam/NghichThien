  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1058}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cbdfddbb1a7e9dedeeccda6985376314, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  itemId: 247
  indentLevel: 2
  storyText: 听完你的话，他陷入沉思。藏经阁也因此恢复了寂静，且会在你们离开之后长久地沉陷于寂静之中。
  description:
  AvatarIDSetType: 0
