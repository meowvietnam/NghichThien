  m_GameObject: {fileID: 1024}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cbdfddbb1a7e9dedeeccda6985376314, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  itemId: 225
  indentLevel: 0
  storyText: 这里的灵气浓度还不及武陵城客栈，他一个金丹修士怎会于此设下洞府？
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 3944}
  AvatarIntID: 1
