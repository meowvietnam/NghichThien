  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 3889}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cbdfddbb1a7e9dedeeccda6985376314, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  itemId: 201
  indentLevel: 0
  storyText: 眼前的水潭直径不过四五十米，但却深不见底，漆黑的水面下不断泛起刺骨的寒意，令人感到不安。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 0
