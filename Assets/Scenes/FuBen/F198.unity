  m_Name:
  m_EditorClassIdentifier:
  itemId: 251
  indentLevel: 1
  storyText: 不过，若是着重于吸收精血中的能量助人突破，这样妖化的风险大大降低了。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 1
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 1
  waitForClick: 1
  stopVoiceover: 1
  waitForVO: 0
