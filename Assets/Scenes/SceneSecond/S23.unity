  m_Name:
  m_EditorClassIdentifier:
  itemId: 27
  indentLevel: 0
  storyText: '{vpunch=10,0.5}你！你是当年那个！'
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 2240
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
