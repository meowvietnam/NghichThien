  m_Name:
  m_EditorClassIdentifier:
  itemId: 69
  indentLevel: 0
  storyText: 既然上次的教训还不够，我今天就再让你长长记性！{vpunch=10,0.5}
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 571}
  AvatarIntID: 2240
  character: {fileID: 0}
  portrait: {fileID: 0}
