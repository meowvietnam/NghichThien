  m_Name:
  m_EditorClassIdentifier:
  itemId: 66
  indentLevel: 0
  storyText: 但王登此时可没时间留意他们。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 571}
  AvatarIntID: 0
  character: {fileID: 0}
