  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cbdfddbb1a7e9dedeeccda6985376314, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  itemId: 451
  indentLevel: 0
  storyText: '{xiongdi}可知大名鼎鼎的星宫双圣？这两位前辈便是星宫的创始人，而林家便是双圣中广微仙子的家族。所以林家家主丹阳子前辈，虽不是广微仙子的嫡系，但也是关系较近的后辈。'
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
