  m_Name:
  m_EditorClassIdentifier:
  itemId: 452
  indentLevel: 0
  storyText: 当代宫主虽很少出面，但对林家也是照顾有加。所以丹阳子前辈在星宫中的地位可不一般。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 609
