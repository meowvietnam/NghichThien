  m_Name:
  m_EditorClassIdentifier:
  itemId: 47
  indentLevel: 3
  storyText: 道友有所不知，由于此次拍卖事关重大，所以各门派、家族都只是派了代表前来。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
