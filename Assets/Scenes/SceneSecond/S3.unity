  m_EditorClassIdentifier:
  itemId: 380
  indentLevel: 3
  storyText: 不错...能在50岁前突破筑基，未来若是得些机缘的话，能再突破至金丹期也未可知啊。
  description:
  AvatarIDSetType: 1
  AvatarID: {fileID: 627}
  AvatarIntID: 417
