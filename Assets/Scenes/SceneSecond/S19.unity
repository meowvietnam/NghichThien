  m_EditorClassIdentifier:
  itemId: 399
  indentLevel: 0
  storyText: "{xiongdi}有所不知，本来我也将信将疑。当时那商贩周围想购买此图的人可谓是张袂成阴，不过他说这地图无需竞\r价，只售给有缘人。"
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
