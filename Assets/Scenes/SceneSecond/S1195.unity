  m_EditorClassIdentifier:
  itemId: 373
  indentLevel: 1
  storyText: 多谢{FirstName}{xiongdi}带来消息，我倪府必将找出登上那海上仙山的办法。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 609
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
