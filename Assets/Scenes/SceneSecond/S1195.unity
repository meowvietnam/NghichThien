  m_Name:
  m_EditorClassIdentifier:
  itemId: 125
  indentLevel: 1
  storyText: 不成，我想想还是觉得有些古怪。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 609
  character: {fileID: 0}
  portrait: {fileID: 0}
