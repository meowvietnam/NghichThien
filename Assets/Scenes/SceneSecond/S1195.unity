  m_Name:
  m_EditorClassIdentifier:
  itemId: 127
  indentLevel: 1
  storyText: 若觉得我到处惹是生非招人嫌何必等到今日才表露出来？
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
  AvatarIntID: 609
  character: {fileID: 0}
  portrait: {fileID: 0}
