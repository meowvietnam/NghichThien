  m_Name:
  m_EditorClassIdentifier:
  itemId: 138
  indentLevel: 0
  storyText: 你心神合一，探查着宁王府内的情况，一道略有熟悉的声音传入你的脑海。
  description:
  AvatarIDSetType: 0
  AvatarID: {fileID: 0}
