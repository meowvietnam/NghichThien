  m_Name: Step_1_TS
  m_EditorClassIdentifier: Assembly-CSharp::CreateCharacter.CharStats.SelectionStepData
  <StepType>k__BackingField: 0
  <Id>k__BackingField: 0
  <Title>k__BackingField: "Ng\u01B0\u01A1i xu\u1EA5t sinh"
  <Description>k__BackingField: "T\u1EA1i \u0111\xE2y, ng\u01B0\u1EDDi ch\u01A1i
    s\u1EBD l\u1EF1a ch\u1ECDn xu\u1EA5t th\xE2n, gia th\u1EBF, thi\xEAn ph\xFA,
    v\xE0 nh\u1EEFng nh\xE2n t\u1ED1 ng\u1EABu nhi\xEAn c\u1EE7a thi\xEAn \u0111\u1EA1o.
    M\u1ED7i quy\u1EBFt \u0111\u1ECBnh \u0111\u1EC1u \u1EA3nh h\u01B0\u1EDFng tr\u1EF1c
    ti\u1EBFp \u0111\u1EBFn con \u0111\u01B0\u1EDDng tu luy\u1EC7n v\u1EC1 sau: t\u1ED1c
    \u0111\u1ED9 \u0111\u1ED9t ph\xE1 c\u1EA3nh gi\u1EDBi, c\u01A1 duy\xEAn k\u1EF3
    ng\u1ED9, m\u1ED1i quan h\u1EC7 v\u1EDBi c\xE1c th\u1EBF l\u1EF1c, th\u1EADm
    ch\xED l\xE0 sinh t\u1EED h\u1ECDa ph\xFAc."
  <Groups>k__BackingField:
  - <Id>k__BackingField: 0
    <StatOptions>k__BackingField:
    - <Id>k__BackingField: 0
      <Name>k__BackingField: "Lang thang c\xF4 nhi"
      <Modifiers>k__BackingField:
      - <Type>k__BackingField: 11
        <Action>k__BackingField: 1
        <Value>k__BackingField: -10
        <Cost>k__BackingField: -1
      <Effective>k__BackingField: "Ban \u0111\u1EA7u kh\xED huy\u1EBFt -10"
      <Description>k__BackingField: "Ng\u01B0\u01A1i t\u1EEB nh\u1ECF li\u1EC1n th\xE2n
        m\u1ED9t m\xECnh, kh\xF4ng bi\u1EBFt ph\u1EE5 m\u1EABu t\xEAn h\u1ECD. Kh\xF4ng
        c\xF3 ch\u1ED7 \u1EDF c\u1ED1 \u0111\u1ECBnh l\u01B0u l\xE3ng t\u1EEB x\u1EE9,
        th\u1EE5 r\u1EA5t nhi\u1EC1u l\xE0m nh\u1EE5c c\u0169ng r\u01A1i xu\u1ED1ng
        kh\xF4ng \xEDt b\u1EC7nh c\u0103n."
    - <Id>k__BackingField: 1
      <Name>k__BackingField: "Ph\u1ED5 th\xF4ng n\xF4ng h\u1ED9"
      <Modifiers>k__BackingField:
      - <Type>k__BackingField: 0
        <Action>k__BackingField: 0
        <Value>k__BackingField: 0
        <Cost>k__BackingField: 0
      <Effective>k__BackingField: "Kh\xF4ng"
      <Description>k__BackingField: "Ng\u01B0\u01A1i xu\xE2t th\xE2n t\u1EEB s\u01A1n
        d\xE3 m\xE3ng phu nh\xE0, sinh ho\u1EA1t an nh\xE0n phong ph\xFA, nh\u01B0ng
        c\u0169ng b\xECnh th\u1EA3n kh\xF4ng c\xF3 g\xEC l\u1EA1."
    - <Id>k__BackingField: 2
      <Name>k__BackingField: "Luy\u1EC7n v\xF5 th\u1EBF gia"
      <Modifiers>k__BackingField:
      - <Type>k__BackingField: 11
        <Action>k__BackingField: 1
        <Value>k__BackingField: 10
        <Cost>k__BackingField: 1
      <Effective>k__BackingField: "Ban \u0111\u1EA7u kh\xED huy\u1EBFt +10"
      <Description>k__BackingField: "Ng\u01B0\u01A1i sinh ra \u1EDF Ninh Ch\xE2u
        m\u1ED9t c\xE1i luy\u1EC7n v\xF5 th\u1EBF gia, khi c\xF2n b\xE9 ng\u01B0\u01A1i
        li\u1EC1n theo v\xF5 qu\xE1n b\xEAn trong s\u01B0 ph\u1EE5 h\u1ECDc \u0111\u01B0\u1EE3c
        kh\xF4ng \xEDt c\xF4ng phu quy\u1EC1n c\u01B0\u1EDBc."
    - <Id>k__BackingField: 3
      <Name>k__BackingField: "Th\u01B0\u01A1ng nh\xE2n ph\xFA h\xE0o"
      <Modifiers>k__BackingField:
      - <Type>k__BackingField: 10
        <Action>k__BackingField: 1
        <Value>k__BackingField: 15000
        <Cost>k__BackingField: 1
      <Effective>k__BackingField: "Ban \u0111\u1EA7u linh th\u1EA1ch +15000"
      <Description>k__BackingField: "Ng\u01B0\u01A1i sinh ra \u1EDF Ninh Ch\xE2u
        m\u1ED9t c\xE1i nh\xE0 ph\xFA h\xE0o, ph\u1EE5 m\u1EABu v\xEC \u0111\u1EC3
        cho ng\u01B0\u01A1i c\xF3 th\u1EC3 \u0111i v\xE0o ti\xEAn \u0111\u1ED3, t\u1EEB
        nh\u1ECF v\xEC ng\u01B0\u01A1i chu\u1EA9n b\u1ECB m\u1ED9t \u0111\u1ED1ng
        l\u1EDBn linh th\u1EA1ch."
    - <Id>k__BackingField: 4
      <Name>k__BackingField: "Gia t\u1ED9c tu ch\xE2n"
      <Modifiers>k__BackingField:
      - <Type>k__BackingField: 15
        <Action>k__BackingField: 2
        <Value>k__BackingField: 524288
        <Cost>k__BackingField: 2
      <Effective>k__BackingField: "C\xF4ng ph\xE1p ban \u0111\u1EA7u \u0111\u01B0\u1EE3c
        thay \u0111\u1ED5i th\xE0nh Ng\u0169 Ph\u1EE7 \u0110o\xE1n Nguy\xEAn Quy\u1EBFt"
      <Description>k__BackingField: "Ng\u01B0\u01A1i sinh ra \u1EDF Ninh Ch\xE2u
        m\u1ED9t c\xE1i xu\u1ED1ng d\u1ED1c gia t\u1ED9c tu ch\xE2n, d\xF9 t\xE0i
        nguy\xEAn kh\xF4ng nhi\u1EC1u nh\u01B0ng c\xF3 c\xF4ng ph\xE1p c\u1EE7a m\xECnh
        truy\u1EC1n th\u1EEBa."
    - <Id>k__BackingField: 5
      <Name>k__BackingField: "Th\u01B0 h\u01B0\u01A1ng m\xF4n \u0111\u1EC7"
      <Modifiers>k__BackingField:
      - <Type>k__BackingField: 7
        <Action>k__BackingField: 1
        <Value>k__BackingField: 10
        <Cost>k__BackingField: 2
      <Effective>k__BackingField: "Ban \u0111\u1EA7u ng\u1ED9 t\xEDnh +10"
      <Description>k__BackingField: "Ng\u01B0\u01A1i sinh ra \u1EDF Ninh Ch\xE2u
        m\u1ED9t c\xE1i th\u01B0 h\u01B0\u01A1ng th\u1EBF gia, t\u1EEB ti\u1EC3u
        th\u1EE5 kinh v\u0103n hun \u0111\xFAc"
    <Exclusives>k__BackingField: 
  - <Id>k__BackingField: 1
    <StatOptions>k__BackingField:
    - <Id>k__BackingField: 6
      <Name>k__BackingField: "H\u1ED3n xuy\xEAn d\u1ECB th\u1EBF"
      <Modifiers>k__BackingField:
      - <Type>k__BackingField: 8
        <Action>k__BackingField: 1
        <Value>k__BackingField: 3
        <Cost>k__BackingField: 1
      <Effective>k__BackingField: "Ban \u0111\u1EA7u th\u1EA7n th\u1EE9c +3"
      <Description>k__BackingField: "Linh h\u1ED3n c\u1EE7a ng\u01B0\u01A1i t\u1EEB
        m\u1ED9t ph\u01B0\u01A1ng kh\xE1c th\u1EBF gi\u1EDBi xuy\xEAn qua m\xE0 \u0111\u1EBFn,
        m\u1EB7c d\xF9 \u0111\xE3 m\u1EA5t \u0111i tr\xED nh\u1EDB c\u1EE7a ki\u1EBFp
        tr\u01B0\u1EDBc, nh\u01B0ng b\u1EDFi v\xEC \u0111\xE3 t\u1EEBng ti\u1EBFp
        th\u1EE5 qua ch\xEDn n\u0103m gi\xE1o d\u1EE5c b\u1EAFt bu\u1ED9c, th\u1EA7n
        tr\xED c\u1EE7a ng\u01B0\u01A1i mu\u1ED1n so c\xF9ng giai tu s\u0129 m\u1EA1nh
        l\xEAn r\u1EA5t nhi\u1EC1u."
