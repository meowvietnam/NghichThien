        kh\xF4ng \xEDt tr\xE2n qu\xFD th\u1EA3o d\u01B0\u1EE3c."
    <Exclusives>k__BackingField: 21000000
  - <Id>k__BackingField: 27
    <StatOptions>k__BackingField:
    - <Id>k__BackingField: 48
      <Name>k__BackingField: "\u0110\u1ED9ng qu\u1EADt sau n\xFAi"
