        <Value>k__BackingField: -30
        <Cost>k__BackingField: -1
      <Effective>k__BackingField: "T\xE2m c\u1EA3nh -30"
      <Description>k__BackingField: "M\u01B0\u1EDDi l\u0103m tu\u1ED5i n\u0103m \u0111\xF3,
        ng\u01B0\u01A1i h\xF4n \u01B0\u1EDBc \u0111\u1ED1i t\u01B0\u1EE3ng gh\xE9t
        b\u1ECF ng\u01B0\u01A1i t\u01B0\u1EDBng m\u1EA1o kh\xF4ng t\u1ED1t sai ng\u01B0\u1EDDi
        b\u1ED9i \u01B0\u1EDBc, ng\u01B0\u01A1i chuy\u1EC7n nh\u01B0 v\u1EADy b\u1ECB
        \u0111\xE1m ng\u01B0\u1EDDi ch\u1EBF gi\u1EC5u, th\u1EADt to \u1EA3nh h\u01B0\u1EDFng
        t\u1EDBi t\xE2m t\xEDnh c\u1EE7a ng\u01B0\u01A1i."
    <Exclusives>k__BackingField: 21000000
  - <Id>k__BackingField: 24
    <StatOptions>k__BackingField:
    - <Id>k__BackingField: 45
