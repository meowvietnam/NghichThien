        <Cost>k__BackingField: 1
      <Effective>k__BackingField: "Th\u1ECD nguy\xEAn +10"
      <Description>k__BackingField: "C\u0169ng kh\xF4ng bi\u1EBFt v\xEC sao, t\u1EEB
