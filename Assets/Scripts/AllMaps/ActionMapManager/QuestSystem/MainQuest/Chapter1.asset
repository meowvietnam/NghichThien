  <Id>k__BackingField: 1
  nameItem: 
  spriteItem: {fileID: 0}
  prefabIcon: {fileID: 337230255643885407, guid: 68d5e1ac7aef1bc4d935172386a4de2d,
    type: 3}
  completeQuest:
  - "C\u1EA3m \u01A1n ng\u01B0\u01A1i ! tr\xF4ng ng\u01B0\u01A1i c\xF3 v\u1EBB nh\u01B0
    l\xE0 m\u1ED9t t\xE1n tu v\u1EADy c\u1EA7m l\u1EA5y th\u0103ng ti\xEAn l\u1EC7nh
    n\xE0y ng\u01B0\u1EDDi c\xF3 th\u1EC3 gia nh\u1EADp b\u1EA5t k\xEC th\u1EBF l\u1EF1c
    n\xE0o. V\u1EADy nh\xE9 , t\u1EA1m bi\u1EC7t. \xC0 ta l\xE0 ti\u1EC3u th\u01B0
    nh\xE0 h\u1ECD H\xE0 t\u1EA1i V\xE2n T\u1ECBch th\xE0nh n\u1EBFu r\u1EA3nh ng\u01B0\u01A1i
    c\xF3 th\u1EBF t\u1EDBi ch\u01A1i v\u1EDBi ta."
  - "Nghe ta n\xE0y! Mu\u1ED1n t\xECm d\u01B0\u1EE3c li\u1EC7u t\u1ED1t nh\u1EA5t
    \xE1? Ch\u1EC9 c\xF3 th\u1EC3 l\xE0 V\xE2n T\u1ECBch Th\xE0nh c\u1EE7a ta th\xF4i!
    C\xF2n v\u1EADt li\u1EC7u ch\u1EBF t\u1EA1o th\xEC... c\u1EE9 ph\xF3ng sang D\u1EADt
    Phong Th\xE0nh m\xE0 gom nh\xE9. \xC0, c\xF2n mu\u1ED1n luy\u1EC7n c\xF4ng ph\xE1p
    hay b\xED k\xEDp th\u1EA7n th\xF4ng \xE1? D\u1EC5 \u1EE3t! Gh\xE9 ngay Thi\xEAn
    Tinh Th\xE0nh, ho\u1EB7c l\xE0... l\u1EE5c tung T\xE0ng Kinh C\xE1c trong t\xF4ng
    ph\xE1i c\u1EE7a ng\u01B0\u01A1i l\xEAn l\xE0 xong h\u1EBFt \xE0!"
  - "Mu\u1ED1n l\u0129nh ng\u1ED9 k\u1EF9 n\u0103ng hay tu luy\u1EC7n, th\xEC c\u1EE9
    t\u1EA1t v\xE0o m\u1EA5y c\xE1i kh\xE1ch s\u1EA1n \u1EDF c\xE1c th\xE0nh tr\xEC...
    ho\u1EB7c v\u1EC1 th\u1EB3ng t\xF4ng ph\xE1i cho ti\u1EC7n c\u0169ng \u0111\u01B0\u1EE3c
    nha! \u1EDE m\u1EA5y ch\u1ED7 \u0111\xF3, c\xF2n c\xF3 c\u1EA3 ch\u1ED7 luy\u1EC7n
    \u0111an, luy\u1EC7n kh\xED lu\xF4n.  "
  - "\xC0 qu\xEAn n\u1EEFa, \u1EDF m\u1ED7i n\u01A1i \u0111\xF3 \u0111\u1EC1u c\xF3
    m\u1ED9t b\u1EA3ng danh s\xE1ch nhi\u1EC7m v\u1EE5 ri\xEAng bi\u1EC7t \u0111\xF3,
    nh\u1EDB nh\u1EADn \u0111\u1EC3 ki\u1EBFm th\xEAm ch\xFAt linh th\u1EA1ch v\xE0
    ti\xEAn ng\u1ECDc nha!"
  - "B\u1EADt m\xED n\xE8! C\u1EE9 m\u1ED7i th\xE1ng tu luy\u1EC7n, l\xE0 ng\u01B0\u01A1i
    \u0111\u01B0\u1EE3c h\u1ED3i ph\u1EE5c t\u1EADn 10% kh\xED huy\u1EBFt t\u1ED1i
    \u0111a lu\xF4n! Nh\u01B0ng m\xE0 ch\xFA \xFD nha... n\u1EBFu t\xE2m c\u1EA3nh
    c\u1EE7a ng\u01B0\u01A1i 'cao' h\u01A1n tu vi, th\xEC t\u1ED1c \u0111\u1ED9 tu
    luy\u1EC7n s\u1EBD t\u0103ng v\u1ECDt 50% lu\xF4n \u0111\xF3. C\xF2n n\u1EBFu
    kh\xF4ng... h\xEC h\xEC, coi ch\u1EEBng b\u1ECB gi\u1EA3m 50% t\u1ED1c \u0111\u1ED9
    nha! \u0110\u1EEBng ch\u1EC9 c\xF3 t\u1EADp trung v\xE0o tu luy\u1EC7n qu\xE1,
    k\u1EBBo t\xE2m c\u1EA3nh gi\u1EA3m qu\xE1 m\u1EE9c \u0111\xF3!  "
  - "C\xF2n n\u1EBFu ng\u01B0\u01A1i mu\u1ED1n ch\u1EE9ng t\u1ECF b\u1EA3n l\u0129nh
    c\u1EE7a m\xECnh \xE1, th\xEC mau mau ra \u0110\u1EA5u Tr\u01B0\u1EDDng \u1EDF
    D\u1EADt Phong Th\xE0nh ngay nha! \u1EDE \u0111\xF3 c\xF3 b\u1EA3ng x\u1EBFp
    h\u1EA1ng cao th\u1EE7 l\u1EAFm \u0111\xF3, m\xE0 leo h\u1EA1ng c\xE0ng cao th\xEC
    ph\u1EA7n th\u01B0\u1EDFng linh th\u1EA1ch, ti\xEAn ng\u1ECDc nh\u1EADn v\u1EC1
    tay... ch\xE0, nhi\u1EC1u \u0111\u1EBFn m\u1EE9c \u0111\u1EBFm kh\xF4ng xu\u1EC3
    lu\xF4n!"
  - "\xC0 su\xFDt n\u1EEFa th\xEC qu\xEAn! N\u1EBFu mu\u1ED1n s\u1EDF h\u1EEFu c\xE1c
    k\u1EF3 tr\xE2n d\u1ECB b\u1EA3o hay k\u1EF9 n\u0103ng hi\u1EBFm c\xF3 kh\xF3
    t\xECm, th\xEC nh\u1EDB canh me c\xE1c B\xED C\u1EA3nh s\u1EBD xu\u1EA5t hi\u1EC7n
    v\xE0o khung gi\u1EDD c\u1ED1 \u0111\u1ECBnh nh\xE9! Ho\u1EB7c kh\xF4ng... h\xEC
    h\xEC, c\u1EE9 th\u1EED v\u1EADn may \u1EDF ch\u1ED7 quay th\u01B0\u1EDFng xem
    sao, bi\u1EBFt \u0111\xE2u l\u1EA1i v\u1EDB \u0111\u01B0\u1EE3c b\u1EA3o v\u1EADt
    ngon l\xE0nh \u0111\xF3 nha!"
  - "Cu\u1ED1i c\xF9ng n\xE8! Nh\u1EDB theo d\xF5i trang c\xE1 nh\xE2n c\u1EE7a Thi\xEAn
    \u0110\u1EA1o tr\xEAn Facebook nh\xE9. Thi tho\u1EA3ng, h\u1EAFn h\u1EE9ng l\xEAn
    s\u1EBD l\xE0m 'l\u1ED9' ra m\u1EA5y c\xF4ng th\u1EE9c ch\u1EBF t\u1EA1o \u0111an
    d\u01B0\u1EE3c c\u1EF1c hi\u1EBFm \u0111\xF3! Ph\u1EA3i c\xF3 \u0111an ph\u01B0\u01A1ng
    trong tay m\u1EDBi luy\u1EC7n \u0111\u01B0\u1EE3c, ch\u1EE9 kh\xF4ng th\xEC...
    ng\u01B0\u01A1i m\xF2 m\u1EABm kh\xF3 kh\u0103n l\u1EAFm m\u1EDBi ra \u0111\xF3
    nha!"
  startQuest:
  - "AAAA... C\xF4ng... c\xF4ng t\u1EED!! L\xE0m \u01A1n... c\u1EE9u... c\u1EE9u
    ta v\u1EDBi!!"
