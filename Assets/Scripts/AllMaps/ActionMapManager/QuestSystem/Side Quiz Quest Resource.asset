  m_Script: {fileID: 11500000, guid: 302cef7a3e9f95d42a44aa10286481ca, type: 3}
  m_Name: Side Quiz Quest Resource
  m_EditorClassIdentifier: Assembly-CSharp::SideQuizQuestResource
  prefabIcon: {fileID: 337230255643885407, guid: 48defdb980396be4da54c52813bdf6de,
    type: 3}
  quizDatas:
  - quiz: "Trong truy\u1EC7n 'S\u1EF1 t\xEDch Th\u1EA1ch Sanh', Th\u1EA1ch Sanh \u0111\xE3
      d\xF9ng v\u0169 kh\xED g\xEC \u0111\u1EC3 k\u1EBFt li\u1EC5u Ch\u1EB1n tinh?"
    answer:
    - "C\xE2y r\xECu s\u1EAFt"
    - "Cung t\xEAn th\u1EA7n"
    - "Thanh g\u01B0\u01A1m b\xE1u"
    - "G\u1EADy t\u1EA7m v\xF4ng"
    rightAnswerIndex: 0
  - quiz: "Con v\u1EADt n\xE0o \u0111\xE3 gi\xFAp \u0111\u1EE1 An Ti\xEAm v\xE0 gia
      \u0111\xECnh t\xECm ra gi\u1ED1ng d\u01B0a h\u1EA5u ngo\xE0i \u0111\u1EA3o
      hoang?"
    answer:
    - "Chim ph\u01B0\u1EE3ng ho\xE0ng"
    - "\u0110\xE0n chim tr\u1EAFng"
    - "B\u1EA7y kh\u1EC9 \u0111u\xF4i d\xE0i"
    - "R\xF9a th\u1EA7n \u0110\xF4ng H\u1EA3i"
    rightAnswerIndex: 1
  - quiz: "Trong truy\u1EC7n 'T\u1EA5m C\xE1m', sau khi T\u1EA5m b\u1ECB ng\xE3 c\xE2y
      cau ch\u1EBFt, c\xF4 \u0111\xE3 h\xF3a th\xE2n th\xE0nh sinh v\u1EADt n\xE0o
      \u0111\u1EA7u ti\xEAn?"
    answer:
    - "Chim v\xE0nh khuy\xEAn"
    - "C\xE2y xoan \u0111\xE0o"
    - "Chim v\xE0ng anh"
    - "Qu\u1EA3 th\u1ECB th\u01A1m"
    rightAnswerIndex: 2
  - quiz: "V\u1EADt ph\u1EA9m \u0111\u1ECBnh t\xECnh gi\xFAp Lang Li\xEAu n\u1EB7n
      ra b\xE1nh ch\u01B0ng, b\xE1nh gi\u1EA7y d\xE2ng l\xEAn Vua H\xF9ng l\xE0 g\xEC?"
    answer:
    - "G\u1EA1o n\u1EBFp, \u0111\u1EADu xanh, l\xE1 dong"
    - "H\u1EA1t ng\u1ECDc tr\u1EDDi"
    - "M\u1EADt ong r\u1EEBng"
    - "C\u1EE7 m\xE0i tr\xEAn n\xFAi"
    rightAnswerIndex: 0
  - quiz: "Trong truy\u1EC7n 'S\u1EF1 t\xEDch c\xE2y v\xFA s\u1EEFa', c\u1EADu b\xE9
      \u0111\xE3 \xF4m l\u1EA5y th\xE2n c\xE2y g\xEC sau khi \u0111i l\u1EA1c tr\u1EDF
      v\u1EC1 nh\xE0?"
    answer:
    - "C\xE2y m\xEDt"
    - "C\xE2y b\u01B0\u1EDFi"
    - "C\xE2y xo\xE0i"
    - "C\xE2y v\xFA s\u1EEFa"
    rightAnswerIndex: 3
  - quiz: "\u0110\u1EC3 c\u01B0\u1EDBi \u0111\u01B0\u1EE3c M\u1EF5 N\u01B0\u01A1ng,
      S\u01A1n Tinh v\xE0 Th\u1EE7y Tinh ph\u1EA3i t\xECm \u0111\u1EE7 s\xEDnh l\u1EC5
      n\xE0o sau \u0111\xE2y?"
    answer:
    - "Voi ch\xEDn ng\xE0, G\xE0 ch\xEDn c\u1EF1a, Ng\u1EF1a ch\xEDn h\u1ED3ng mao"
    - "Voi ch\xEDn ng\xE0, H\u1ED5 ch\xEDn \u0111u\xF4i, Ng\u1EF1a ch\xEDn h\u1ED3ng
      mao"
    - "Voi ch\xEDn ng\xE0, G\xE0 ch\xEDn c\u1EF1a, R\u1ED3ng bi\u1EC3n ch\xEDn \u0111\u1EA7u"
    - "Voi v\xE0ng, G\xE0 ng\u1ECDc, Ng\u1EF1a ch\xEDn h\u1ED3ng mao"
    rightAnswerIndex: 0
  - quiz: "Trong truy\u1EC7n 'C\xE2y tre tr\u0103m \u0111\u1ED1t', c\xE2u th\u1EA7n
      ch\xFA d\xF9ng \u0111\u1EC3 g\u1EAFn k\u1EBFt c\xE1c \u0111\u1ED1t tre l\u1EA1i
      v\u1EDBi nhau l\xE0 g\xEC?"
    answer:
    - "Kh\u1EAFc xu\u1EA5t, kh\u1EAFc xu\u1EA5t"
    - "Kh\u1EAFc nh\u1EADp, kh\u1EAFc nh\u1EADp"
    - "M\u1EDF c\u1EEDa ra, m\u1EDF c\u1EEDa ra"
    - "Bi\u1EBFn h\xECnh, bi\u1EBFn h\xECnh"
    rightAnswerIndex: 1
  - quiz: "S\u1EF1 t\xEDch h\u1ED3 Ba B\u1EC3 g\u1EAFn li\u1EC1n v\u1EDBi h\xECnh
      \u1EA3nh ng\u01B0\u1EDDi b\xE0 g\xF3a \u0111\xE3 c\u1EE9u gi\xFAp ai c\u1EA3i
      trang?"
    answer:
    - "M\u1ED9t \xF4ng l\xE3o \u0103n xin"
    - "M\u1ED9t c\u1EE5 b\xE0 \u1ED1m y\u1EBFu"
    - "M\u1ED9t con Giao Long"
    - "B\xE0 l\xE3o \u0103n m\xE0y (Giao Long h\xF3a th\xE2n)"
    rightAnswerIndex: 3
  - quiz: "Trong truy\u1EC7n 'S\u1EF1 t\xEDch Tr\u1EA7u Cau', ng\u01B0\u1EDDi anh
      trai \u0111\xE3 bi\u1EBFn th\xE0nh v\u1EADt g\xEC \u0111\u1EA7u ti\xEAn khi
      g\u1EE5c ch\u1EBFt?"
    answer:
    - "T\u1EA3ng \u0111\xE1 v\xF4i"
    - "C\xE2y cau th\u1EB3ng \u0111\u1EE9ng"
    - "C\xE2y tr\u1EA7u kh\xF4ng d\xE2y leo"
    - "D\xF2ng su\u1ED1i nh\u1ECF"
    rightAnswerIndex: 0
  - quiz: "Vua L\xEA L\u1EE3i \u0111\xE3 ho\xE0n tr\u1EA3 thanh g\u01B0\u01A1m Thu\u1EADn
      Thi\xEAn cho th\u1EA7n Kim Quy \u1EDF ng\xF4i h\u1ED3 n\xE0o?"
    answer:
    - "H\u1ED3 T\xE2y"
    - "H\u1ED3 Ho\xE0n Ki\u1EBFm (H\u1ED3 G\u01B0\u01A1m)"
    - "H\u1ED3 Ba B\u1EC3"
    - "H\u1ED3 Th\xE1c B\xE0"
    rightAnswerIndex: 1
  wrongDialog:
  - "Sai r\u1ED3i! Ti\u1EBFc thay cho m\u1ED9t t\xE2m tr\xED c\xF2n qu\xE1 nhi\u1EC1u
    t\u1EA1p ni\u1EC7m, ch\u01B0a th\u1EA5u hi\u1EC3u \u0111\u01B0\u1EE3c ch\xE2n
    l\xFD."
